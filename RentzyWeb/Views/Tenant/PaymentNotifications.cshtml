@model List<Rentzy.DAL.Models.PaymentNotification>

@{
    ViewData["Title"] = "Notifications";
}

<h2>Payment Notifications</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No notifications yet.</div>
}
else
{
    <ul class="list-group">
        @foreach (var n in Model)
        {
            <li class="list-group-item @(n.IsSeen ? "" : "list-group-item-warning")">
                <a asp-action="OpenNotification" asp-route-id="@n.Id">@n.Message</a>
                <small class="text-muted float-end">@n.SentAt.ToString("dd/MM/yyyy HH:mm")</small>
            </li>
        }
    </ul>
}
