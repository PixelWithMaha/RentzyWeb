@model Rentzy.BLL.DTOs.ReviewDTO

@{
    ViewData["Title"] = "Submit Property Review";
}

<style>
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .star-rating input {
        display: none;
    }

    .star-rating label {
        font-size: 2.5rem;
        color: #d1d5db; /* gray-300 */
        cursor: pointer;
        transition: color 0.2s ease-in-out, transform 0.2s;
    }

    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: #f59e0b; /* amber-500 */
        transform: scale(1.1);
    }

    .review-card {
        background-color: var(--theme-card-bg);
        border: 1px solid var(--theme-border);
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: var(--theme-shadow);
    }

    .premium-header {
        background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%);
        color: white;
        padding: 2.5rem 2rem;
    }

    .form-floating > .form-control,
    .form-floating > textarea {
        background-color: var(--theme-input-bg);
        border-color: var(--theme-input-border);
        color: var(--theme-text);
    }

    .form-floating > .form-control:focus,
    .form-floating > textarea:focus {
        background-color: var(--theme-input-bg);
        border-color: #4f46e5;
        color: var(--theme-text);
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.25);
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Tenant" asp-action="MyBookings" class="text-decoration-none">My Bookings</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Write Review</li>
                </ol>
            </nav>

            <div class="card review-card">
                <div class="premium-header text-center position-relative">
                    <div class="position-absolute top-0 start-0 w-100 h-100 bg-white opacity-10" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
                    <i class="fas fa-quote-left fa-3x opacity-25 mb-3"></i>
                    <h2 class="fw-bold mb-2">Share Your Experience</h2>
                    <p class="lead mb-0 opacity-75">Help others decide by rating your time at <strong>@Model.PropertyTitle</strong></p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="PropertyId" />
                        <input type="hidden" asp-for="PropertyTitle" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 border-0 shadow-sm" role="alert">
                        </div>

                        <div class="mb-4 pb-2 text-center">
                            <label class="form-label fw-bold fs-5 d-block mb-3 text-body">How would you rate this property?</label>
                            <div class="star-rating d-inline-flex flex-row-reverse justify-content-center w-100">
                                <input type="radio" id="star5" asp-for="Rating" value="5" />
                                <label for="star5" title="5 stars"><i class="fas fa-star"></i></label>

                                <input type="radio" id="star4" asp-for="Rating" value="4" />
                                <label for="star4" title="4 stars"><i class="fas fa-star"></i></label>

                                <input type="radio" id="star3" asp-for="Rating" value="3" />
                                <label for="star3" title="3 stars"><i class="fas fa-star"></i></label>

                                <input type="radio" id="star2" asp-for="Rating" value="2" />
                                <label for="star2" title="2 stars"><i class="fas fa-star"></i></label>

                                <input type="radio" id="star1" asp-for="Rating" value="1" />
                                <label for="star1" title="1 star"><i class="fas fa-star"></i></label>
                            </div>
                            <span asp-validation-for="Rating" class="text-danger d-block mt-2 small fw-bold"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea class="form-control" placeholder="Tell us about the property, landlord, and neighborhood..." 
                                      asp-for="Comment" style="height: 160px; border-radius: 1rem;"></textarea>
                            <label asp-for="Comment" class="text-muted">Your detailed feedback (What did you love? Any issues?)</label>
                            <span asp-validation-for="Comment" class="text-danger small fw-bold mt-1"></span>
                        </div>

                        <div class="alert alert-light border rounded-3 mb-4 p-3 bg-opacity-10 text-muted small" style="background-color: var(--theme-muted-bg);">
                            <i class="fas fa-info-circle me-2 text-primary"></i> Note: Your review will be publicly visible under this property listing to help prospective tenants.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Tenant" asp-action="MyBookings" class="btn btn-light px-4 py-2 rounded-pill border">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill shadow fw-bold">
                                Post Review <i class="fas fa-paper-plane ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
