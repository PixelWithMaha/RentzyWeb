@using Rentzy.DAL.Models
@model List<Rentzy.DAL.Models.LandlordApproval>

@{
    ViewData["Title"] = "Landlord Approvals";
    var statuses = ViewBag.ApprovalStatuses as List<Rentzy.DAL.Models.ApprovalStatus> ?? new List<Rentzy.DAL.Models.ApprovalStatus>();
    int currentStatus = ViewBag.CurrentStatusId ?? 1;
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-8">
            <h3><i class="fas fa-check-circle me-2 text-primary"></i>Landlord Approvals</h3>
            <p class="text-muted">Manage landlord verification requests</p>
        </div>
        <div class="col-4 text-end">
            <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard", "Admin")"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form method="get" class="d-flex gap-2 align-items-center">
                        <label class="mb-0">Filter Status:</label>
                        <select name="statusId" class="form-select w-auto" onchange="this.form.submit()">
                            @foreach (var s in statuses)
                            {
                                <option value="@s.Id" selected="@(s.Id == currentStatus ? "selected" : null)">
                                    @s.Name
                                </option>
                            }
                        </select>
                        <a class="btn btn-sm btn-outline-primary ms-2" href="@Url.Action("LandlordApprovals", "Admin")">Reset</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-user-clock" style="font-size:3rem; opacity:0.2"></i>
                        <p class="mt-3 text-muted">No approval requests found for selected status.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Landlord</th>
                                        <th>Submitted</th>
                                        <th>Status</th>
                                        <th>Reviewed At</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>
                                                <strong>@(item.Landlord?.FirstName) @(item.Landlord?.LastName)</strong><br />
                                                <small class="text-muted">@item.Landlord?.Email</small>
                                            </td>
                                            <td>@item.SubmittedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>

                                            <td>
                                                <span class="badge bg-@(item.ApprovalStatusId == 1 ? "secondary" : item.ApprovalStatusId == 2 ? "success" : item.ApprovalStatusId == 3 ? "danger" : "warning")">
                                                    @(item.ApprovalStatus?.Name ?? "Unknown")
                                                </span>
                                            </td>

                                            <td>
                                                @(item.ReviewedAt.HasValue? item.ReviewedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")
                                            </td>

                                            <td class="text-end">

                                                @if (item.ApprovalStatusId == ApprovalStatusConstants.Pending)
                                                {
                                                    <div class="d-flex justify-content-end gap-2">

                                                        <button class="btn btn-sm btn-success"
                                                                onclick="openNotesModal(@item.Id, 'approve')">
                                                            <i class="fas fa-check me-1"></i>Approve
                                                        </button>

                                                        <button class="btn btn-sm btn-danger"
                                                                onclick="openNotesModal(@item.Id, 'reject')">
                                                            <i class="fas fa-times me-1"></i>Reject
                                                        </button>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex justify-content-end gap-2">

                                                        <a class="btn btn-sm btn-outline-primary"
                                                           href="@Url.Action("LandlordApprovalDetails", "Admin", new { id = item.Id })">
                                                            <i class="fas fa-eye me-1"></i>View
                                                        </a>

                                                        <a class="btn btn-sm btn-warning"
                                                           href="@Url.Action("EditLandlordApprovalStatus", "Admin", new { id = item.Id })">
                                                            <i class="fas fa-edit me-1"></i>Edit Status
                                                        </a>

                                                    </div>
                                                }

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


<!-- 🌟 NOTES MODAL (Approve/Reject) -->
<div class="modal fade" id="notesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="notesForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Notes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="approvalId" />

                    <textarea name="notes" class="form-control" rows="4" placeholder="Write notes here..." required></textarea>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function openNotesModal(id, actionType) {
            document.getElementById("approvalId").value = id;

            if (actionType === "approve") {
                document.getElementById("modalTitle").innerText = "Approve Landlord - Add Notes";
                document.getElementById("notesForm").action = "/Admin/ApproveLandlord";
            }
            else {
                document.getElementById("modalTitle").innerText = "Reject Landlord - Add Notes";
                document.getElementById("notesForm").action = "/Admin/RejectLandlord";
            }

            var modal = new bootstrap.Modal(document.getElementById('notesModal'));
            modal.show();
        }
    </script>
}
