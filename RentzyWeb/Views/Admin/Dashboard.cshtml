@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 mb-4">
        <div class="d-flex justify-content-between align-items-center p-4 text-white"
             style="background: linear-gradient(135deg,#667eea,#764ba2); border-radius: 12px;">

            <div>
                <h2 class="mb-1"><i class="fas fa-user-shield me-2"></i>Welcome, @ViewBag.UserName!</h2>
                <p class="mb-0 opacity-75">Admin Dashboard</p>
            </div>

            <a asp-controller="Account" asp-action="Profile"
               class="btn btn-outline-light px-4 py-2"
               style="font-size:1.1rem; border-radius: 10px;">
                <i class="fas fa-user-circle me-2"></i>My Profile
            </a>
        </div>
    </div>


    <div class="row g-4">
        <!-- System Stats -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-users text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Total Users</h5>
                    <h2 class="text-primary mb-0">@ViewBag.TotalUsers</h2>
                    <p class="text-muted small">Registered Users</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-building text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Total Properties</h5>
                    <h2 class="text-success mb-0">@ViewBag.TotalProperties</h2>
                    <p class="text-muted small">Listed Properties</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-user-tie text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Landlords</h5>
                    <h2 class="text-warning mb-0">@ViewBag.ActiveLandlords</h2>
                    <p class="text-muted small">Active Landlords</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-user-friends text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Tenants</h5>
                    <h2 class="text-info mb-0">@ViewBag.ActiveTenants</h2>
                    <p class="text-muted small">Active Tenants</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-cog me-2 text-primary"></i>Admin Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a asp-controller="Admin" asp-action="ManageUsers"
                               class="btn btn-outline-primary w-100 py-3">
                                <i class="fas fa-users-cog d-block mb-2" style="font-size: 2rem;"></i>
                                Manage Users
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Admin" asp-action="LandlordApprovals"
                               class="btn btn-outline-warning w-100 py-3">
                                <i class="fas fa-check-circle d-block mb-2" style="font-size: 2rem;"></i>
                                Verify Landlords
                            </a>

                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Admin" asp-action="PropertyApprovals"
                               class="btn btn-outline-success w-100 py-3">
                                <i class="fas fa-check-circle d-block mb-2" style="font-size: 2rem;"></i>
                                Manage Properties
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="AdminReports" asp-action="Index"
                               class="btn btn-outline-info w-100 py-3">
                                <i class="fas fa-chart-bar d-block mb-2" style="font-size: 2rem;"></i>
                                System Reports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row mt-4">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-clock me-2 text-primary"></i>Recent User Registrations
                    </h5>
                </div>

                <div class="card-body" style="min-height: 340px;">
                    @if (ViewBag.RecentUsers == null || ViewBag.RecentUsers.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-user-plus" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="mt-3">No recent registrations</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var u in ViewBag.RecentUsers)
                            {
                                var first = (u.FirstName ?? "");
                                var last = (u.LastName ?? "");
                                <li class="list-group-item d-flex justify-content-between py-3">
                                    <span style="font-size:1.05rem;">
                                        @(first + (string.IsNullOrWhiteSpace(last) ? "" : " " + last))
                                    </span>
                                    <small class="text-muted">@(((DateTime)u.CreatedAt).ToShortDateString())</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Pending Actions
                    </h5>
                </div>

                <div class="card-body" style="min-height: 340px;">
                    @if (ViewBag.PendingActions == null || ViewBag.PendingActions.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-tasks" style="font-size: 3rem; opacity: 0.3;"></i>
                            <p class="mt-3">No pending actions</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var p in ViewBag.PendingActions)
                            {
                                <li class="list-group-item d-flex justify-content-between py-3">
                                    <span style="font-size:1.05rem;">@p.LandlordName</span>
                                    <small class="text-muted">Pending</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

</div>  