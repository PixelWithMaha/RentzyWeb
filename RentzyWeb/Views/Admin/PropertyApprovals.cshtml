@using Rentzy.DAL.Models
@model List<Rentzy.DAL.Models.PropertyApprovalRequest>

@{
    ViewData["Title"] = "Property Approvals";
    var statuses = ViewBag.ApprovalStatuses as List<Rentzy.DAL.Models.ApprovalStatus> ?? new List<Rentzy.DAL.Models.ApprovalStatus>();
    int currentStatus = ViewBag.CurrentStatusId ?? 1;
}

<div class="container mt-4">

    <div class="row mb-3">
        <div class="col-8">
            <h3><i class="fas fa-home me-2 text-primary"></i>Property Approvals</h3>
            <p class="text-muted">Manage property verification requests</p>
        </div>

        <div class="col-4 text-end">
            <a class="btn btn-outline-secondary" href="@Url.Action("Dashboard", "Admin")">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <form method="get" class="d-flex gap-2 align-items-center">
                        <label class="mb-0">Filter Status:</label>

                        <select name="statusId" class="form-select w-auto" onchange="this.form.submit()">
                            @foreach (var s in statuses)
                            {
                                <option value="@s.Id" selected="@(s.Id == currentStatus ? "selected" : null)">
                                    @s.Name
                                </option>
                            }
                        </select>

                        <a class="btn btn-sm btn-outline-primary ms-2"
                           href="@Url.Action("PropertyApprovals", "Admin")">Reset</a>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- If list empty -->
    @if (Model == null || !Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-file-alt" style="font-size:3rem; opacity:0.2"></i>
                        <p class="mt-3 text-muted">No property approval requests for selected status.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Table -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Property</th>
                                        <th>Requested At</th>
                                        <th>Status</th>
                                        <th>Reviewed At</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Id</td>

                                            <td>
                                                <strong>@item.property?.Title</strong><br />
                                                <small class="text-muted">ID: @item.PropertyId</small>
                                            </td>

                                            <td>@item.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>

                                            <td>
                                                <span class="badge bg-@(
                                                      item.StatusId == 1 ? "secondary" :
                                                      item.StatusId == 2 ? "success" :
                                                      item.StatusId == 3 ? "danger" : "warning"
                                                                                                )">
                                            @(item.Status?.Name ?? "Unknown")
                                        </span>
                                    </td>

                                    <td>
                                        @(item.ReviewedAt.HasValue
                                                                                ? item.ReviewedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                                                : "-")
                                    </td>

                                            <td class="text-end">

                                        @if (item.StatusId == 1)
                                                {
                                                    <!-- Pending -->
                                                    <div class="d-flex justify-content-end gap-2">

                                                        <!-- Approve -->
                                                        <form asp-action="ApproveProperty" asp-controller="Admin" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <button type="submit" class="btn btn-sm btn-success"
                                                                    onclick="return confirm('Approve this property?');">
                                                                <i class="fas fa-check me-1"></i>Approve
                                                            </button>
                                                        </form>

                                                        <!-- Reject -->
                                                        <form asp-action="RejectProperty" asp-controller="Admin" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <button type="submit" class="btn btn-sm btn-danger"
                                                                    onclick="return confirm('Reject this request?');">
                                                                <i class="fas fa-times me-1"></i>Reject
                                                            </button>
                                                        </form>

                                                        <!-- Cancel -->
                                                        <form asp-action="CancelPropertyRequest" asp-controller="Admin" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <button type="submit" class="btn btn-sm btn-warning"
                                                                    onclick="return confirm('Cancel this request?');">
                                                                <i class="fas fa-ban me-1"></i>Cancel
                                                            </button>
                                                        </form>

                                                    </div>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-sm btn-outline-primary"
                                                       href="@Url.Action("PropertyApprovalDetails", "Admin", new { id = item.Id })">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </a>
                                                }

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div> <!-- table-responsive -->
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        // future enhancements
    </script>
}
