@model IEnumerable<Rentzy.BLL.DTOs.PropertyDTO>

<style>
    .properties-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .property-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border: none;
        overflow: hidden;
        position: relative;
    }

        .property-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

    .property-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .property-card:hover .property-image {
        transform: scale(1.05);
    }

    .property-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 2;
    }

    .property-content {
        padding: 1.5rem;
    }

    .property-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        line-height: 1.3;
    }

    .property-price {
        font-size: 1.8rem;
        font-weight: 800;
        color: #667eea;
        margin-bottom: 1rem;
    }

    .property-price-period {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
    }

    .property-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 1.5rem 0;
        padding: 1rem 0;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
    }

    .detail-item {
        text-align: center;
        flex: 1;
    }

    .detail-label {
        display: block;
        font-size: 0.8rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        display: block;
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
    }

    .landlord-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .landlord-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .landlord-details h6 {
        margin: 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .landlord-details small {
        color: #6c757d;
    }

    .badge-available {
        background: rgba(81, 207, 102, 0.15);
        color: #51cf66;
        border: 1px solid rgba(81, 207, 102, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-rented {
        background: rgba(255, 107, 107, 0.15);
        color: #ff6b6b;
        border: 1px solid rgba(255, 107, 107, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .view-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        width: 100%;
        text-decoration: none;
        display: block;
        text-align: center;
    }

        .view-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

    .search-section {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        margin-bottom: 2rem;
    }

    .search-form {
        display: flex;
        gap: 1rem;
        align-items: end;
    }

    .form-group {
        flex: 1;
    }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .search-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2.5rem;
        color: white;
        margin-bottom: 2rem;
        text-align: center;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 0;
    }

    .properties-count {
        background: white;
        border-radius: 15px;
        padding: 1rem 1.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #2c3e50;
        margin-top: 1rem;
    }

    .no-properties {
        text-align: center;
        padding: 4rem 2rem;
        color: #6c757d;
    }

        .no-properties i {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
</style>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">Discover Your Dream Home</h1>
        <p class="page-subtitle">Browse through our curated collection of premium rental properties</p>
        <div class="properties-count">
            <i class="fas fa-home text-primary"></i>
            <span>@Model.Count() Properties Available</span>
        </div>
    </div>

    <!-- Search Section -->
    <div class="search-section">
        <form asp-controller="Property" asp-action="Index" method="get" class="search-form">
            <div class="form-group">
                <label class="form-label">Search Properties</label>
                <input type="text" name="searchType" class="form-control" placeholder="Search by property type..." />
            </div>
            <button type="submit" class="search-btn">
                <i class="fas fa-search me-2"></i>Search
            </button>
        </form>
    </div>

    <!-- Properties Grid -->
    @if (Model.Any())
    {
        <div class="properties-grid">
            @foreach (var prop in Model)
            {
                <div class="property-card">
                    <!-- Property Image -->
                    <div class="position-relative">
                        <img src="@(prop.Images?.FirstOrDefault()?.ImageUrl ?? "/images/default-property.jpg")"
                             class="property-image"
                             alt="@prop.Title" />

                        <!-- Availability Badge -->
                        <div class="property-badge">
                            @if (prop.TenantNames.Any())
                            {
                                <span class="badge-rented">
                                    <i class="fas fa-times-circle me-1"></i>Rented
                                </span>
                            }
                            else
                            {
                                <span class="badge-available">
                                    <i class="fas fa-check-circle me-1"></i>Available
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Property Content -->
                    <div class="property-content">
                        <!-- Title and Price -->
                        <h3 class="property-title">@prop.Title</h3>
                        <div class="property-price">
                            $@prop.Rent<span class="property-price-period">/month</span>
                        </div>

                        <!-- Property Details -->
                        <div class="property-details">
                            <div class="detail-item">
                                <span class="detail-label">Landlord</span>
                                <span class="detail-value">@prop.LandlordName</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Status</span>
                                <span class="detail-value @(prop.TenantNames.Any() ? "text-danger" : "text-success")">
                                    @(prop.TenantNames.Any() ? "Rented" : "Available")
                                </span>
                            </div>
                        </div>

                        <!-- Landlord Info -->
                        <div class="landlord-info">
                            <div class="landlord-avatar">
                                @prop.LandlordName?.Substring(0, 1)
                            </div>
                            <div class="landlord-details">
                                <h6>@prop.LandlordName</h6>
                                <small>Property Owner</small>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <a class="view-btn"
                           asp-controller="Booking"
                           asp-action="Details"
                           asp-route-id="@prop.Id">
                            <i class="fas fa-eye me-2"></i>View Property Details
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-properties">
            <i class="fas fa-home"></i>
            <h3>No Properties Found</h3>
            <p>Try adjusting your search criteria to find more properties.</p>
        </div>
    }
</div>

<!-- Add Font Awesome for icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>