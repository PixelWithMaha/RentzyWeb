@model IEnumerable<Rentzy.BLL.DTOs.PropertyDTO>

<h1>Properties</h1>

<form asp-controller="Property" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchType" class="form-control" placeholder="Search by property type..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Property Name</th>
            <th>Rent Amount</th>
            <th>Landlord</th>
            <th>Tenants</th>
            <th>Action</th>   <!--  NEW -->
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Model)
        {
            <tr>
                <td>
                    <img src="@prop.Images?.FirstOrDefault()?.ImageUrl"
                         style="width:100px;height:70px;object-fit:cover;border-radius:6px;" />
                    <div>@prop.Title</div>
                </td>

                <td>@prop.Rent</td>

                <td>@prop.LandlordName</td>

                <td>
                    @if (prop.TenantNames.Any())
                    {
                        <span class="text-danger fw-bold">Currently Rented</span>
                    }
                    else
                    {
                        <span class="text-success fw-bold">Available</span>
                    }
                </td>

                <td>
                    <a class="btn btn-primary btn-sm"
                       asp-controller="Booking"
                       asp-action="Details"
                       asp-route-id="@prop.Id">
                        View
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
