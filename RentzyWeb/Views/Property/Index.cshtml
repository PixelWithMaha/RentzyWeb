@model IEnumerable<Rentzy.BLL.DTOs.PropertyDTO>

<h1>Properties</h1>

<form asp-controller="Property" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchType" class="form-control" placeholder="Search by property type..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Property Name</th>
            <th>Rent Amount</th>
            <th>Landlord</th>
            <th>Tenants</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Model)
        {
            <tr>
                <td>@prop.Title</td>
                <td>@prop.Rent</td>
                <td>@prop.LandlordName</td>
                <td>
                    @if (prop.TenantNames.Any())
                    {
                        <ul>
                            @foreach (var tenant in prop.TenantNames)
                            {
                                <li>@tenant</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span>No tenants</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
