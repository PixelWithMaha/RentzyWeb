@model IEnumerable<Rentzy.DAL.Models.Property>

<h1>Properties</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Property Name</th>
            <th>Rent Amount</th>
            <th>Landlord</th>
            <th>Tenants</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var prop in Model)
        {
                <tr>
                    <td>@prop.Title</td>
                    <td>@prop.MonthlyRent</td>
                    <td>@(prop.Landlord != null ? prop.Landlord.FirstName + " " + prop.Landlord.LastName : "N/A")</td>
                    <td>
                    @if (prop.Bookings != null && prop.Bookings.Any())
                    {
                                <ul>
                            @foreach (var booking in prop.Bookings)
                            {
                                        <li>@(booking.Tenant.FirstName + " " + booking.Tenant.LastName)</li>
                            }
                                </ul>
                    }
                    else
                    {
                                <span>No tenants</span>
                    }
                    </td>
                </tr>
        }
    </tbody>
</table>
