@{
    ViewData["Title"] = "Request Property";
    var bookedDatesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BookedDates ?? new List<string>());
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .calendar-section {
        background: var(--theme-card-bg);
        border: 1px solid var(--theme-border);
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        max-width: 800px;
        margin: 2rem auto;
    }

    .date-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .form-control {
        border: 2px solid var(--theme-input-border);
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
        background-color: var(--theme-input-bg);
        color: var(--theme-text);
        border: 1px solid var(--theme-input-border) !important;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 1rem;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    /* NUCLEAR CSS - Force colors no matter what */
    .flatpickr-calendar {
        width: 320px !important;
        border-radius: 15px !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
        border: none !important;
        font-family: 'Segoe UI', sans-serif !important;
        z-index: 10000 !important;
    }

    .flatpickr-months {
        border-radius: 15px 15px 0 0 !important;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        padding: 10px 0 !important;
    }

    .flatpickr-month {
        color: white !important;
        fill: white !important;
        height: 34px !important;
        line-height: 1 !important;
    }

    .flatpickr-current-month {
        color: white !important;
        font-weight: 600 !important;
        font-size: 1.1rem !important;
        padding-top: 0 !important;
    }

    .flatpickr-weekdays {
        background: var(--theme-hero-bg) !important;
        padding: 10px 0 !important;
    }

    .flatpickr-weekday {
        color: #667eea !important;
        font-weight: 600 !important;
    }

    .flatpickr-day {
        border-radius: 8px !important;
        border: 2px solid transparent !important;
        font-weight: 500 !important;
        margin: 2px !important;
        height: 40px !important;
        line-height: 36px !important;
        background: #51cf66 !important;
        color: white !important;
        border-color: #51cf66 !important;
    }

        .flatpickr-day:hover {
            background: #40c057 !important;
            border-color: #40c057 !important;
        }

        /* Only SPECIFICALLY marked disabled dates should be RED */
        .flatpickr-day.flatpickr-disabled {
            background: #ff6b6b !important;
            color: white !important;
            border-color: #ff6b6b !important;
            text-decoration: line-through !important;
            cursor: not-allowed !important;
        }

            .flatpickr-day.flatpickr-disabled:hover {
                background: #ff5252 !important;
                border-color: #ff5252 !important;
            }

        /* Selected dates */
        .flatpickr-day.selected,
        .flatpickr-day.startRange,
        .flatpickr-day.endRange {
            background: #667eea !important;
            border-color: #667eea !important;
        }

        .flatpickr-day.inRange {
            background: rgba(102, 126, 234, 0.2) !important;
            color: #667eea !important;
        }

    .form-label {
        font-weight: 600;
        color: var(--theme-text);
        margin-bottom: 0.5rem;
    }

    .alert-success {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 1rem;
    }

    .alert-danger {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #ff6b6b 0%, #ff5252 100%);
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 1rem;
    }
</style>

<div class="calendar-section">
    <h3 class="text-center mb-4">Select Your Dates</h3>

    <!-- Debug Info -->
    <div style="background: var(--theme-hero-bg); color: var(--theme-text); padding: 15px; border: 1px solid var(--theme-border); border-radius: 10px; margin-bottom: 20px; font-size: 14px;">
        <h5>Calendar Status:</h5>
        <p><strong>Property:</strong> @ViewBag.PropertyTitle</p>
        <p><strong>Booked Dates Count:</strong> <span id="bookedCount">@(ViewBag.BookedDates?.Count ?? 0)</span></p>
        <p><strong>Booked Dates:</strong> <span id="bookedDatesList">@string.Join(", ", ViewBag.BookedDates ?? new List<string>())</span></p>
        <p><strong>Status:</strong> <span id="statusMessage">Loading...</span></p>
    </div>

    <form asp-action="Request" method="post" id="requestForm">
        <input type="hidden" name="propertyId" value="@ViewBag.PropertyId" />

        <div class="date-inputs">
            <div>
                <label for="startDate" class="form-label">Start Date</label>
                <input type="text" class="form-control" id="startDate" name="startDate" placeholder="Select start date" required readonly>
            </div>
            <div>
                <label for="endDate" class="form-label">End Date</label>
                <input type="text" class="form-control" id="endDate" name="endDate" placeholder="Select end date" required readonly>
            </div>
        </div>

        <!-- Validation Message -->
        <div id="validationMessage" class="alert-danger" style="display: none; margin-top: 1rem;"></div>

        <button type="submit" class="btn btn-primary" id="sendRequestBtn">
            Send Booking Request
        </button>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-danger mt-3">
            @TempData["Error"]
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const bookedDates = @Html.Raw(bookedDatesJson);

    console.log("=== CALENDAR DEBUG ===");
    console.log("Property ID:", @ViewBag.PropertyId);
    console.log("Raw booked dates from server:", bookedDates);
    console.log("Booked dates count:", bookedDates.length);

    // Debug each booked date
    if (bookedDates.length > 0) {
        console.log("Booked dates details:");
        bookedDates.forEach((date, index) => {
            console.log(`  ${index + 1}. ${date}`);
        });
    }

    // Update status message
    const statusElement = document.getElementById('statusMessage');
    if (bookedDates.length === 0) {
        statusElement.innerHTML = '<span style="color: green;">✅ ALL DATES AVAILABLE - Calendar is GREEN</span>';
        console.log("All dates should be GREEN");
    } else {
        statusElement.innerHTML = '<span style="color: orange;">⚠️ Some dates are booked - Mixed GREEN/RED</span>';
        console.log("Some dates should be RED");
    }

    // Function to check if selected range includes booked dates
    function hasBookedDatesInRange(startDate, endDate) {
        const start = new Date(startDate);
        const end = new Date(endDate);
        const bookedDatesSet = new Set(bookedDates);

        let conflictDates = [];
        const currentDate = new Date(start);

        while (currentDate <= end) {
            const year = currentDate.getFullYear();
            const month = String(currentDate.getMonth() + 1).padStart(2, '0');
            const day = String(currentDate.getDate()).padStart(2, '0');
            const dateStr = `${year}-${month}-${day}`;

            if (bookedDatesSet.has(dateStr)) {
                conflictDates.push(dateStr);
            }
            currentDate.setDate(currentDate.getDate() + 1);
        }

        return conflictDates;
    }

    // Function to update validation message
    function updateValidationMessage(startDate, endDate) {
        const validationElement = document.getElementById('validationMessage');

        if (!startDate || !endDate) {
            validationElement.style.display = 'none';
            return;
        }

        const conflictDates = hasBookedDatesInRange(startDate, endDate);

        if (conflictDates.length > 0) {
            validationElement.innerHTML = `❌ Selected dates include booked periods: ${conflictDates.join(', ')}. Please choose different dates.`;
            validationElement.style.display = 'block';
            document.getElementById('sendRequestBtn').disabled = true;
        } else {
            validationElement.style.display = 'none';
            document.getElementById('sendRequestBtn').disabled = false;
        }
    }

    // Simple config with manual date control
    const flatpickrConfig = {
        dateFormat: "Y-m-d",
        minDate: "today",
        position: "below",
        zIndex: 10000,
        onDayCreate: function(dObj, dStr, fp, dayElem) {
            // Get the date string for this day (YYYY-MM-DD format)
            const date = new Date(dayElem.dateObj);
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const dateStr = `${year}-${month}-${day}`;

            // Remove any existing disabled class first
            dayElem.classList.remove('flatpickr-disabled');

            // If this date is in bookedDates, mark it as disabled
            if (bookedDates.includes(dateStr)) {
                dayElem.classList.add('flatpickr-disabled');
            }
        },
        onChange: function(selectedDates, dateStr, instance) {
            // Update validation when dates change
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            updateValidationMessage(startDate, endDate);
        }
    };

    // Initialize date pickers
    const startPicker = flatpickr("#startDate", {
        ...flatpickrConfig,
        onChange: function(selectedDates, dateStr, instance) {
            if (selectedDates.length > 0) {
                endPicker.set('minDate', selectedDates[0]);
            }
            // Update validation
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            updateValidationMessage(startDate, endDate);
        }
    });

    const endPicker = flatpickr("#endDate", {
        ...flatpickrConfig,
        onChange: function(selectedDates, dateStr, instance) {
            // Update validation
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            updateValidationMessage(startDate, endDate);
        }
    });

    // Form validation
    document.getElementById('requestForm').addEventListener('submit', function(e) {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        if (!startDate || !endDate) {
            e.preventDefault();
            alert('Please select both start and end dates.');
            return;
        }

        const start = new Date(startDate);
        const end = new Date(endDate);

        if (end <= start) {
            e.preventDefault();
            alert('End date must be after start date.');
            return;
        }

        // Check for booked dates in range
        const conflictDates = hasBookedDatesInRange(startDate, endDate);

        if (conflictDates.length > 0) {
            e.preventDefault();
            alert(`Cannot book: Selected dates include booked periods (${conflictDates.join(', ')}). Please choose different dates.`);
            return;
        }

        // If we get here, the dates are valid and can be submitted
        console.log("Dates are valid, submitting form...");
    });

    console.log("Calendar initialized successfully");
</script>