@{
    ViewData["Title"] = "Request Property";
    var bookedDatesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BookedDates ?? new List<string>());
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .calendar-section {
        background: var(--theme-card-bg);
        border: 1px solid var(--theme-border);
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        max-width: 800px;
        margin: 2rem auto;
    }

    .date-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .form-control {
        border: 2px solid var(--theme-input-border);
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
        background-color: var(--theme-input-bg);
        color: var(--theme-text);
        border: 1px solid var(--theme-input-border) !important;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 1rem;
        color: #ffffff !important;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    /* ===== FLATPICKR CALENDAR STYLES ===== */
    .flatpickr-calendar {
        width: 320px !important;
        border-radius: 15px !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
        border: none !important;
        font-family: 'Segoe UI', sans-serif !important;
        z-index: 10000 !important;
    }

    .flatpickr-months {
        border-radius: 15px 15px 0 0 !important;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        padding: 10px 0 !important;
    }

    .flatpickr-month {
        color: white !important;
        fill: white !important;
        height: 34px !important;
        line-height: 1 !important;
    }

    .flatpickr-current-month {
        color: white !important;
        font-weight: 600 !important;
        font-size: 1.1rem !important;
        padding-top: 0 !important;
    }

    .flatpickr-weekdays {
        background: var(--theme-hero-bg) !important;
        padding: 10px 0 !important;
    }

    .flatpickr-weekday {
        color: #667eea !important;
        font-weight: 600 !important;
    }

    /* DEFAULT: future available dates = GREEN */
    .flatpickr-day {
        border-radius: 8px !important;
        border: 2px solid transparent !important;
        font-weight: 500 !important;
        margin: 2px !important;
        height: 40px !important;
        line-height: 36px !important;
        background: #51cf66 !important;
        color: white !important;
        border-color: #51cf66 !important;
    }

        .flatpickr-day:hover {
            background: #40c057 !important;
            border-color: #40c057 !important;
        }

        /* PAST dates = GREY, not selectable */
        .flatpickr-day.flatpickr-disabled {
            background: #dee2e6 !important;
            color: #adb5bd !important;
            border-color: #dee2e6 !important;
            cursor: not-allowed !important;
            text-decoration: none !important;
            opacity: 0.7 !important;
            pointer-events: none !important;
        }

            .flatpickr-day.flatpickr-disabled:hover {
                background: #dee2e6 !important;
                border-color: #dee2e6 !important;
            }

        /* Days outside current month = light grey */
        .flatpickr-day.prevMonthDay,
        .flatpickr-day.nextMonthDay {
            background: #f1f3f5 !important;
            color: #ced4da !important;
            border-color: #f1f3f5 !important;
            opacity: 0.5 !important;
        }

        /* BOOKED dates = RED */
        .flatpickr-day.booked-date {
            background: #ff6b6b !important;
            color: white !important;
            border-color: #ff6b6b !important;
            text-decoration: line-through !important;
            cursor: not-allowed !important;
            pointer-events: none !important;
        }

            .flatpickr-day.booked-date:hover {
                background: #ff5252 !important;
                border-color: #ff5252 !important;
            }

        /* Selected dates = purple/blue */
        .flatpickr-day.selected,
        .flatpickr-day.startRange,
        .flatpickr-day.endRange {
            background: #667eea !important;
            border-color: #667eea !important;
            color: white !important;
        }

        .flatpickr-day.inRange {
            background: rgba(102, 126, 234, 0.2) !important;
            color: #667eea !important;
            border-color: transparent !important;
        }

    .flatpickr-prev-month svg,
    .flatpickr-next-month svg {
        fill: white !important;
    }

    .flatpickr-prev-month,
    .flatpickr-next-month {
        fill: white !important;
        color: white !important;
    }

    /* ===== LEGEND ===== */
    .calendar-legend {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--theme-text);
        font-weight: 500;
    }

    .legend-dot {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }

    .legend-green {
        background: #51cf66;
    }

    .legend-red {
        background: #ff6b6b;
    }

    .legend-grey {
        background: #dee2e6;
    }

    .legend-purple {
        background: #667eea;
    }

    .form-label {
        font-weight: 600;
        color: var(--theme-text);
        margin-bottom: 0.5rem;
    }

    .alert-success {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 1rem;
    }

    .alert-danger {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #ff6b6b 0%, #ff5252 100%);
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 1rem;
    }
</style>

<div class="calendar-section">
    <h3 class="text-center mb-3">Select Your Dates</h3>
    <p class="text-center text-muted mb-3" style="font-size:0.9rem;">
        Booking for: <strong>@ViewBag.PropertyTitle</strong>
    </p>

    <!-- Legend -->
    <div class="calendar-legend">
        <div class="legend-item">
            <div class="legend-dot legend-green"></div>
            <span>Available</span>
        </div>
        <div class="legend-item">
            <div class="legend-dot legend-red"></div>
            <span>Booked</span>
        </div>
        <div class="legend-item">
            <div class="legend-dot legend-grey"></div>
            <span>Past / Unavailable</span>
        </div>
        <div class="legend-item">
            <div class="legend-dot legend-purple"></div>
            <span>Selected</span>
        </div>
    </div>

    <form asp-action="Request" method="post" id="requestForm">
        <input type="hidden" name="propertyId" value="@ViewBag.PropertyId" />

        <div class="date-inputs">
            <div>
                <label for="startDate" class="form-label">Start Date</label>
                <input type="text" class="form-control" id="startDate" name="startDate" placeholder="Select start date" required readonly>
            </div>
            <div>
                <label for="endDate" class="form-label">End Date</label>
                <input type="text" class="form-control" id="endDate" name="endDate" placeholder="Select end date" required readonly>
            </div>
        </div>

        <!-- Validation Message -->
        <div id="validationMessage" class="alert-danger" style="display: none; margin-top: 1rem;"></div>

        <button type="submit" class="btn btn-primary" id="sendRequestBtn">
            Send Booking Request
        </button>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-danger mt-3">@TempData["Error"]</div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const bookedDates = @Html.Raw(bookedDatesJson);

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    function toDateStr(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function onDayCreate(dObj, dStr, fp, dayElem) {
        const date = new Date(dayElem.dateObj);
        date.setHours(0, 0, 0, 0);

        // Skip days outside current month view
        if (dayElem.classList.contains('prevMonthDay') || dayElem.classList.contains('nextMonthDay')) {
            return;
        }

        // Past dates → grey (flatpickr minDate handles blocking, this is visual)
        if (date < today) {
            dayElem.classList.remove('flatpickr-disabled');
            dayElem.classList.add('flatpickr-disabled');
            return;
        }

        // Booked dates → red
        const dateStr = toDateStr(date);
        if (bookedDates.includes(dateStr)) {
            dayElem.classList.add('booked-date');
            dayElem.classList.add('flatpickr-disabled');
            return;
        }

        // Future available → stays green (default CSS handles it)
    }

    function hasBookedDatesInRange(startDate, endDate) {
        const start = new Date(startDate);
        const end = new Date(endDate);
        const bookedSet = new Set(bookedDates);
        const conflicts = [];
        const cur = new Date(start);

        while (cur <= end) {
            const ds = toDateStr(cur);
            if (bookedSet.has(ds)) conflicts.push(ds);
            cur.setDate(cur.getDate() + 1);
        }
        return conflicts;
    }

    function updateValidationMessage(startDate, endDate) {
        const el = document.getElementById('validationMessage');
        if (!startDate || !endDate) { el.style.display = 'none'; return; }

        const conflicts = hasBookedDatesInRange(startDate, endDate);
        if (conflicts.length > 0) {
            el.innerHTML = `❌ Selected dates include booked periods: ${conflicts.join(', ')}. Please choose different dates.`;
            el.style.display = 'block';
            document.getElementById('sendRequestBtn').disabled = true;
        } else {
            el.style.display = 'none';
            document.getElementById('sendRequestBtn').disabled = false;
        }
    }

    const baseConfig = {
        dateFormat: "Y-m-d",
        minDate: "today",
        position: "below",
        zIndex: 10000,
        onDayCreate: onDayCreate
    };

    const startPicker = flatpickr("#startDate", {
        ...baseConfig,
        onChange: function(selectedDates) {
            if (selectedDates.length > 0) {
                endPicker.set('minDate', selectedDates[0]);
            }
            updateValidationMessage(
                document.getElementById('startDate').value,
                document.getElementById('endDate').value
            );
        }
    });

    const endPicker = flatpickr("#endDate", {
        ...baseConfig,
        onChange: function() {
            updateValidationMessage(
                document.getElementById('startDate').value,
                document.getElementById('endDate').value
            );
        }
    });

    document.getElementById('requestForm').addEventListener('submit', function(e) {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        if (!startDate || !endDate) {
            e.preventDefault();
            alert('Please select both start and end dates.');
            return;
        }

        if (new Date(endDate) <= new Date(startDate)) {
            e.preventDefault();
            alert('End date must be after start date.');
            return;
        }

        const conflicts = hasBookedDatesInRange(startDate, endDate);
        if (conflicts.length > 0) {
            e.preventDefault();
            alert(`Cannot book: Selected dates include booked periods (${conflicts.join(', ')}). Please choose different dates.`);
        }
    });
</script>
