@{
    ViewData["Title"] = "Request Property";
    var bookedDatesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.BookedDates ?? new List<string>());
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .calendar-section {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        max-width: 800px;
        margin: 2rem auto;
    }

    .date-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .form-control {
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        transition: all 0.3s ease;
        width: 100%;
        margin-top: 1rem;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    /* Flatpickr Custom Styles */
    .flatpickr-calendar {
        width: 320px !important;
        border-radius: 15px !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
        border: none !important;
        font-family: 'Segoe UI', sans-serif !important;
        z-index: 10000 !important;
    }

    .flatpickr-months {
        border-radius: 15px 15px 0 0 !important;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        padding: 10px 0 !important;
    }

    .flatpickr-month {
        color: white !important;
        fill: white !important;
        height: 34px !important;
        line-height: 1 !important;
    }

    .flatpickr-current-month {
        color: white !important;
        font-weight: 600 !important;
        font-size: 1.1rem !important;
        padding-top: 0 !important;
    }

    .flatpickr-monthDropdown-months {
        color: #2c3e50 !important;
        background: white !important;
        border-radius: 5px !important;
        padding: 2px 5px !important;
        font-weight: 600 !important;
    }

    .numInputWrapper {
        color: #2c3e50 !important;
    }

    .numInput {
        color: #2c3e50 !important;
        font-weight: 600 !important;
    }

    .flatpickr-weekdays {
        background: #f8f9fa !important;
        padding: 10px 0 !important;
    }

    .flatpickr-weekday {
        color: #667eea !important;
        font-weight: 600 !important;
    }

    .flatpickr-day {
        border-radius: 8px !important;
        border: 2px solid transparent !important;
        font-weight: 500 !important;
        margin: 2px !important;
        height: 40px !important;
        line-height: 36px !important;
    }

        /* Available dates - Green */
        .flatpickr-day:not(.flatpickr-disabled) {
            background: #51cf66 !important;
            color: white !important;
            border-color: #51cf66 !important;
        }

            .flatpickr-day:not(.flatpickr-disabled):hover {
                background: #40c057 !important;
                border-color: #40c057 !important;
            }

        /* Booked dates - Red */
        .flatpickr-day.flatpickr-disabled {
            background: #ff6b6b !important;
            color: white !important;
            border-color: #ff6b6b !important;
            text-decoration: line-through !important;
            cursor: not-allowed !important;
        }

            .flatpickr-day.flatpickr-disabled:hover {
                background: #ff5252 !important;
                border-color: #ff5252 !important;
            }

        /* Selected dates */
        .flatpickr-day.selected {
            background: #667eea !important;
            border-color: #667eea !important;
            color: white !important;
            font-weight: bold !important;
        }

        .flatpickr-day.startRange {
            background: #667eea !important;
            border-color: #667eea !important;
            color: white !important;
            font-weight: bold !important;
        }

        .flatpickr-day.endRange {
            background: #667eea !important;
            border-color: #667eea !important;
            color: white !important;
            font-weight: bold !important;
        }

        .flatpickr-day.inRange {
            background: rgba(102, 126, 234, 0.2) !important;
            color: #667eea !important;
            border-color: transparent !important;
            box-shadow: -5px 0 0 rgba(102, 126, 234, 0.2), 5px 0 0 rgba(102, 126, 234, 0.2) !important;
        }

    /* Navigation arrows */
    .flatpickr-prev-month,
    .flatpickr-next-month {
        color: white !important;
        fill: white !important;
        padding: 5px 10px !important;
        border-radius: 5px !important;
        transition: background-color 0.3s ease !important;
    }

        .flatpickr-prev-month:hover,
        .flatpickr-next-month:hover {
            background: rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            fill: white !important;
        }

    .form-label {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .alert-success {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 1rem;
    }
</style>

<div class="calendar-section">
    <h3 class="text-center mb-4">Select Your Dates</h3>

    <form asp-action="Request" method="post" id="requestForm">
        <input type="hidden" name="propertyId" value="@ViewBag.PropertyId" />

        <div class="date-inputs">
            <div>
                <label for="startDate" class="form-label">Start Date</label>
                <input type="text" class="form-control" id="startDate" name="startDate" placeholder="Select start date" required readonly>
            </div>
            <div>
                <label for="endDate" class="form-label">End Date</label>
                <input type="text" class="form-control" id="endDate" name="endDate" placeholder="Select end date" required readonly>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" id="sendRequestBtn">
            Send Booking Request
        </button>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    const bookedDates = @Html.Raw(bookedDatesJson);
    const bookedDatesSet = new Set(bookedDates);

    // Convert booked dates to Date objects for flatpickr
    const disabledDates = bookedDates.map(date => new Date(date));

    // Initialize Start Date picker
    const startDatePicker = flatpickr("#startDate", {
        dateFormat: "Y-m-d",
        minDate: "today",
        disable: disabledDates,
        position: "below",
        zIndex: 10000,
        onChange: function(selectedDates, dateStr, instance) {
            if (selectedDates.length > 0) {
                // Update end date min date to be after start date
                endDatePicker.set('minDate', selectedDates[0]);
            }
        }
    });

    // Initialize End Date picker
    const endDatePicker = flatpickr("#endDate", {
        dateFormat: "Y-m-d",
        minDate: "today",
        disable: disabledDates,
        position: "below",
        zIndex: 10000
    });

    // Form submission handler
    document.getElementById('requestForm').addEventListener('submit', function(e) {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        if (!startDate || !endDate) {
            e.preventDefault();
            alert('Please select both start and end dates.');
            return;
        }

        // Validate that end date is after start date
        const start = new Date(startDate);
        const end = new Date(endDate);

        if (end <= start) {
            e.preventDefault();
            alert('End date must be after start date.');
            return;
        }

        // Check for booked dates in range
        let hasBookedInRange = false;
        const currentDate = new Date(start);

        while (currentDate <= end) {
            const dateStr = currentDate.toISOString().split('T')[0];
            if (bookedDatesSet.has(dateStr)) {
                hasBookedInRange = true;
                break;
            }
            currentDate.setDate(currentDate.getDate() + 1);
        }

        if (hasBookedInRange) {
            e.preventDefault();
            alert('The selected range includes booked dates. Please choose different dates.');
        }
    });
</script>