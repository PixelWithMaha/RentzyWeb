@model Rentzy.DAL.Models.Payment
@{
    ViewData["Title"] = "Confirm Payment";
}

<style>
    .gradient-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .payment-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .amount-display {
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        color: white;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
    }

    .payment-method-card {
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .payment-method-card:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }

        .payment-method-card.selected {
            border-color: #667eea;
            background-color: rgba(102, 126, 234, 0.05);
        }

    .confirm-btn {
        background: linear-gradient(135deg, #51cf66 0%, #40c057 100%);
        border: none;
        border-radius: 15px;
        padding: 15px 30px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .confirm-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(76, 175, 80, 0.3);
        }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="card gradient-bg text-white shadow-lg border-0 mb-4">
                <div class="card-body text-center p-4">
                    <h1 class="display-6 fw-bold mb-2">
                        <i class="fas fa-credit-card me-3"></i>Confirm Payment
                    </h1>
                    <p class="lead mb-0 opacity-75">Review and confirm your payment details</p>
                </div>
            </div>

            <!-- Payment Details -->
            <div class="card payment-card mb-4">
                <div class="card-body p-4">
                    <div class="row align-items-center mb-4">
                        <div class="col-md-6">
                            <h4 class="fw-bold text-dark mb-3">
                                <i class="fas fa-home me-2 text-primary"></i>
                                @Model.Booking.Property.Title
                            </h4>
                            <div class="property-info">
                                <p class="mb-2">
                                    <i class="fas fa-calendar-alt me-2 text-info"></i>
                                    <strong>Booking Period:</strong><br>
                                    @Model.Booking.StartDate.ToString("MMM dd, yyyy") - @Model.Booking.EndDate.ToString("MMM dd, yyyy")
                                </p>
                                <p class="mb-0">
                                    <i class="fas fa-user me-2 text-success"></i>
                                    <strong>Landlord:</strong><br>
                                    @Model.Booking.Property.Landlord.FirstName @Model.Booking.Property.Landlord.LastName
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="amount-display">
                                <h5 class="mb-2">Total Amount</h5>
                                <h1 class="display-4 fw-bold mb-0">@Model.Amount.ToString("C")</h1>
                                <p class="mb-0 opacity-75">One-time payment</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Method Selection -->
            <div class="card payment-card mb-4">
                <div class="card-header bg-transparent border-0 py-3">
                    <h4 class="fw-bold mb-0">
                        <i class="fas fa-wallet me-2 text-primary"></i>Select Payment Method
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form id="paymentForm" asp-action="ConfirmPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paymentId" value="@Model.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="payment-method-card" onclick="selectPaymentMethod('credit_card')">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentMethod"
                                               id="creditCard" value="credit_card" checked>
                                        <label class="form-check-label fw-bold" for="creditCard">
                                            <i class="fas fa-credit-card me-2 text-primary"></i>Credit Card
                                        </label>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted">Visa, MasterCard, American Express</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="payment-method-card" onclick="selectPaymentMethod('paypal')">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentMethod"
                                               id="paypal" value="paypal">
                                        <label class="form-check-label fw-bold" for="paypal">
                                            <i class="fab fa-paypal me-2 text-info"></i>PayPal
                                        </label>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted">Fast and secure online payments</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="payment-method-card" onclick="selectPaymentMethod('bank_transfer')">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentMethod"
                                               id="bankTransfer" value="bank_transfer">
                                        <label class="form-check-label fw-bold" for="bankTransfer">
                                            <i class="fas fa-university me-2 text-success"></i>Bank Transfer
                                        </label>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted">Direct bank transfer</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="payment-method-card" onclick="selectPaymentMethod('digital_wallet')">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="paymentMethod"
                                               id="digitalWallet" value="digital_wallet">
                                        <label class="form-check-label fw-bold" for="digitalWallet">
                                            <i class="fas fa-mobile-alt me-2 text-warning"></i>Digital Wallet
                                        </label>
                                    </div>
                                    <div class="mt-2">
                                        <small class="text-muted">Apple Pay, Google Pay</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Terms and Conditions -->
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required>
                            <label class="form-check-label" for="termsCheck">
                                I agree to the <a href="#" class="text-primary">Terms and Conditions</a> and
                                <a href="#" class="text-primary">Privacy Policy</a>
                            </label>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn confirm-btn text-white flex-fill py-3"
                                    onclick="return validateForm()">
                                <i class="fas fa-lock me-2"></i>Confirm & Pay @Model.Amount.ToString("C")
                            </button>
                            <a asp-action="Payment" asp-route-requestId="@Model.BookingId"
                               class="btn btn-outline-secondary py-3">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Notice -->
            <div class="card border-0 bg-light">
                <div class="card-body text-center p-3">
                    <p class="mb-0 text-muted">
                        <i class="fas fa-shield-alt me-2 text-success"></i>
                        Your payment is secured with 256-bit SSL encryption
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectPaymentMethod(method) {
            // Remove selected class from all cards
            document.querySelectorAll('.payment-method-card').forEach(card => {
                card.classList.remove('selected');
            });

            // Add selected class to clicked card
            event.currentTarget.classList.add('selected');

            // Check the corresponding radio button
            document.getElementById(method === 'credit_card' ? 'creditCard' :
                                   method === 'paypal' ? 'paypal' :
                                   method === 'bank_transfer' ? 'bankTransfer' : 'digitalWallet').checked = true;
        }

        function validateForm() {
            const termsChecked = document.getElementById('termsCheck').checked;
            if (!termsChecked) {
                alert('Please agree to the Terms and Conditions to proceed with payment.');
                return false;
            }
            return confirm('Are you sure you want to proceed with this payment?');
        }

        // Initialize first payment method as selected
        document.addEventListener('DOMContentLoaded', function() {
            selectPaymentMethod('credit_card');
        });
    </script>
}