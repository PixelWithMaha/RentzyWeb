@model Dictionary<string, List<Rentzy.DAL.TenantWithProperty>>

@{
    ViewData["Title"] = "My Tenants";
}

<div class="container my-5">

    <h1 class="mb-4 fw-bold" style="font-size: 2rem;">Tenants Overview</h1>

    @foreach (var group in Model)
    {
            <div class="status-section mb-5 p-3 rounded-4">

                <!-- Heading smaller -->
                <h3 class="fw-bold mb-3 text-primary" style="font-size: 1.5rem;">
                @group.Key Tenants
                </h3>

            @if (group.Value != null && group.Value.Count > 0)
            {
                foreach (var tp in group.Value)
                {
                                <div class="tenant-row d-flex justify-content-between align-items-center mb-3 p-3 rounded-4 shadow-sm gradient-box">

                                    <div class="left text-white" style="max-width: 65%;">
                                        <h4 class="fw-bold mb-2" style="font-size: 1.1rem;">@tp.Tenant.FirstName</h4>

                                        <p class="mb-1 opacity-75">Email: @tp.Tenant.Email</p>
                                        <p class="mb-1 opacity-75">Phone: @tp.Tenant.Phone</p>

                                        <p class="mb-1">
                                            Property: <strong class="text-warning">@tp.Property.Title</strong>
                                        </p>
                                    </div>

                                    <div class="right text-end">
                            @if (tp.Booking != null)
                            {
                                                <div class="date-box fw-bold text-dark">
                                    @tp.Booking.StartDate.ToString("dd MMM yyyy")
                                                    <br />
                                                    —
                                                    <br />
                                    @tp.Booking.EndDate.ToString("dd MMM yyyy")
                                                </div>
                            }
                                    </div>

                                </div>
                }
            }
            else
            {
                        <p class="text-muted">No tenants in this category.</p>
            }

            </div>
    }
</div>

<style>
    /* --- COMPACT, PROFESSIONAL CARD STYLE --- */
    .gradient-box {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: white;
        border: none !important;
        transition: 0.25s ease;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        padding: 16px 18px !important; /* smaller card */
        border-radius: 14px;
    }

    .gradient-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 22px rgba(96, 60, 255, 0.38);
    }

    /* Date box cleaned + smaller */
    .date-box {
        background: #efe6ff;
        padding: 10px 14px;
        border-radius: 10px;
        display: inline-block;
        box-shadow: 0 0 6px rgba(120, 80, 255, 0.15);
        min-width: 120px;
        font-size: 0.9rem;
    }

    /* Section container */
    .status-section {
        background: #fafaff;
        border-left: 6px solid #6a11cb;
        padding-left: 20px;
        border-radius: 12px;
    }

    /* Smooth fade animation */
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .tenant-row {
        animation: fadeIn 0.3s ease;
    }
</style>
