@using Rentzy.DAL.Models
@model List<Rentzy.BLL.DTOs.PropertyDTO>

@{
    ViewData["Title"] = "My Properties";
}

<div class="container my-5">

    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header">
                <div class="header-content">
                    <h1><i class="fas fa-home me-2"></i>My Properties</h1>
                    <p>Manage your rental properties</p>
                </div>
                <div class="header-actions">
                    <a href="@Url.Action("AddProperty", "Landlord")" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-2"></i>Add New Property
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
            <!-- Empty State -->
            <div class="empty-state">
                <i class="fas fa-home"></i>
                <h3>No Properties Added Yet</h3>
                <p>Add your first property to start listing rentals</p>
                <a href="@Url.Action("AddProperty", "Landlord")" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add Your First Property
                </a>
            </div>
    }
    else
    {
            <!-- Properties Grid -->
            <div class="properties-grid">
            @foreach (var prop in Model)
            {
                        <div class="property-card">
                            <!-- Property Image -->
                            <div class="property-image-container">
                        @if (prop.Images != null && prop.Images.Any())
                        {
                                        <img src="@prop.Images.First().ImageUrl" alt="@prop.Title" class="property-image">
                        }
                        else
                        {
                                        <div class="property-image-placeholder">
                                            <i class="fas fa-home"></i>
                                            <span>No Image</span>
                                        </div>
                        }

                                <!-- Status Badge -->
                                <div class="status-badge">
                            @if (prop.StatusId == ApprovalStatusConstants.Pending)
                            {
                                            <span class="badge badge-warning">Pending</span>
                            }
                            else if (prop.StatusId == ApprovalStatusConstants.Approved)
                            {
                                            <span class="badge badge-success">Approved</span>
                            }
                            else if (prop.StatusId == ApprovalStatusConstants.Rejected)
                            {
                                            <span class="badge badge-danger">Rejected</span>
                            }
                                </div>
                            </div>

                            <!-- Property Content -->
                            <div class="property-content">
                                <h3 class="property-title">@prop.Title</h3>
                                <p class="property-description">@prop.Description</p>

                                <div class="property-details">
                                    <div class="detail-item">
                                        <i class="fas fa-dollar-sign"></i>
                                        <span class="rent-amount">Rs @prop.Rent</span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="fas fa-city"></i>
                                        <span>@prop.CityName</span>
                                    </div>
                                    <div class="detail-item">
                                        <i class="fas fa-building"></i>
                                        <span>@prop.PropertyTypeName</span>
                                    </div>
                                </div>

                                <!-- Image Gallery -->
                                <div class="image-gallery">
                                    <h6>Property Images</h6>
                            @if (prop.Images != null && prop.Images.Any())
                            {
                                            <div class="gallery-images">
                                    @foreach (var img in prop.Images.Take(4))
                                    {
                                                        <img src="@img.ImageUrl" class="gallery-image" alt="Property Image">
                                    }
                                    @if (prop.Images.Count > 4)
                                    {
                                                        <div class="gallery-more">+@(prop.Images.Count - 4)</div>
                                    }
                                            </div>
                            }
                            else
                            {
                                            <p class="no-images">No images uploaded</p>
                            }
                                </div>

                                <!-- Actions -->
                                <div class="property-actions">
                                    <a href="@Url.Action("EditProperty", "Landlord", new { id = prop.Id })" class="btn-action btn-edit">
                                        <i class="fas fa-edit"></i>
                                        <span>Edit</span>
                                    </a>
                                    <a href="@Url.Action("UpdateImages", "Landlord", new { propertyId = prop.Id })" class="btn-action btn-images">
                                        <i class="fas fa-images"></i>
                                        <span>Images</span>
                                    </a>
                                    <form method="post" asp-action="DeleteProperty" asp-controller="Landlord" 
                                          onsubmit="return confirm('Are you sure you want to delete this property?');" class="d-inline">
                                        <input type="hidden" name="id" value="@prop.Id" />
                                        <button type="submit" class="btn-action btn-delete">
                                            <i class="fas fa-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
            }
            </div>
    }
</div>

<style>
    :root {
        --primary-blue: #1e3a8a;
        --medium-blue: #3b82f6;
        --light-blue: rgba(59, 130, 246, 0.1);
        --purple: #6a11cb;
        --accent-blue: #2575fc;
        --white: var(--theme-card-bg);
        --light-bg: var(--theme-hero-bg);
        --dark-text: var(--theme-text);
        --gray-text: var(--theme-text-muted);
        --border-light: var(--theme-border);
        --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    /* Dashboard Header */
    .dashboard-header {
        background: linear-gradient(135deg, var(--purple) 0%, var(--accent-blue) 100%);
        border-radius: 16px;
        padding: 30px;
        color: var(--white);
        box-shadow: var(--shadow-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .dashboard-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
    }

    .header-content h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
    }

    .header-content p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
    }

    .btn-primary {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: var(--white);
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-primary:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
        color: var(--white);
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: var(--white);
        border-radius: 16px;
        box-shadow: var(--shadow);
    }

    .empty-state i {
        font-size: 4rem;
        color: var(--gray-text);
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        color: var(--dark-text);
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--gray-text);
        margin-bottom: 30px;
    }

    /* Properties Grid */
    .properties-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 25px;
    }

    /* Property Card */
    .property-card {
        background: var(--white);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
        transition: all 0.3s ease;
        border: 1px solid var(--border-light);
    }

    .property-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    /* Property Image */
    .property-image-container {
        position: relative;
        height: 250px;
        overflow: hidden;
    }

    .property-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .property-image-placeholder {
        width: 100%;
        height: 100%;
        background: var(--light-bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--gray-text);
    }

    .property-image-placeholder i {
        font-size: 3rem;
        margin-bottom: 10px;
    }

    /* Status Badge */
    .status-badge {
        position: absolute;
        top: 15px;
        right: 15px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-warning {
        background: #f59e0b;
        color: white;
    }

    .badge-success {
        background: #10b981;
        color: white;
    }

    .badge-danger {
        background: #ef4444;
        color: white;
    }

    /* Property Content */
    .property-content {
        padding: 20px;
    }

    .property-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 10px;
    }

    .property-description {
        color: var(--gray-text);
        margin-bottom: 20px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Property Details */
    .property-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 15px;
        margin-bottom: 20px;
        padding: 15px;
        background: var(--light-bg);
        border-radius: 10px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .detail-item i {
        color: var(--medium-blue);
        width: 16px;
    }

    .rent-amount {
        font-weight: 600;
        color: var(--primary-blue);
    }

    /* Image Gallery */
    .image-gallery {
        margin-bottom: 20px;
    }

    .image-gallery h6 {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 10px;
    }

    .gallery-images {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .gallery-image {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
        border: 2px solid var(--white);
        box-shadow: var(--shadow);
    }

    .gallery-more {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        background: var(--medium-blue);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .no-images {
        color: var(--gray-text);
        font-style: italic;
        font-size: 0.9rem;
        margin: 0;
    }

    /* Property Actions */
    .property-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-action {
        flex: 1;
        min-width: 80px;
        padding: 10px 15px;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-edit {
        background: var(--medium-blue);
        color: white;
    }

    .btn-images {
        background: var(--primary-blue);
        color: white;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
    }

    .btn-action:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .properties-grid {
            grid-template-columns: 1fr;
        }

        .property-details {
            grid-template-columns: 1fr;
        }

        .property-actions {
            flex-direction: column;
        }

        .btn-action {
            min-width: auto;
        }
    }

    @@media (max-width: 480px) {
        .property-image-container {
            height: 200px;
        }

        .property-content {
            padding: 15px;
        }
    }
</style>