@{
    ViewData["Title"] = "Landlord Dashboard";
}

@using Rentzy.DAL.Models
@using System.Linq

<div class="container my-5">

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); color:white;">
                    <div>
                        <h2 class="mb-1"><i class="fas fa-building me-2"></i>Welcome, @ViewBag.UserName!</h2>
                        <p class="mb-0 opacity-75">Landlord Dashboard</p>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-lg shadow-sm">
                            <i class="fas fa-user me-2"></i>My Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Header Ribbon -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="header-ribbon">
                <span>Quick Stats</span>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card stats-card shadow-sm border-0 rounded-3 text-center p-3 h-100 bg-white">
                <i class="fas fa-home text-primary mb-2" style="font-size:2.5rem;"></i>
                <h5 class="text-dark">Total Properties</h5>
                <h3 class="text-dark">@ViewBag.TotalProperties</h3>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card stats-card shadow-sm border-0 rounded-3 text-center p-3 h-100 bg-white">
                <i class="fas fa-users text-success mb-2" style="font-size:2.5rem;"></i>
                <h5 class="text-dark">Active Tenants</h5>
                <h3 class="text-dark">@ViewBag.ActiveTenants</h3>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <a asp-controller="Landlord" asp-action="TenantRequests" class="text-decoration-none">
                <div class="card stats-card shadow-sm border-0 rounded-3 text-center p-3 h-100 bg-white">
                    <i class="fas fa-clipboard-list text-info mb-2" style="font-size:2.5rem;"></i>
                    <h5 class="text-dark">Pending Requests</h5>
                    <h3 class="text-dark">@ViewBag.PendingRequests</h3>
                    @if ((ViewBag.PendingRequests ?? 0) > 0)
                    {
                            <span class="pending-dot"></span>
                    }
                </div>
            </a>
        </div>

        <div class="col-md-3 col-6">
            <div class="card stats-card shadow-sm border-0 rounded-3 text-center p-3 h-100 bg-white">
                <i class="fas fa-dollar-sign text-warning mb-2" style="font-size:2.5rem;"></i>
                <h5 class="text-dark">Monthly Revenue</h5>
                <h3 class="text-dark">$@ViewBag.MonthlyRevenue ?? 0</h3>
            </div>
        </div>
    </div>

    <!-- Quick Actions Header Ribbon -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="header-ribbon">
                <span>Quick Actions</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions Buttons -->
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6">
            <a asp-controller="Landlord" asp-action="AddProperty" class="btn btn-gradient-purple quick-action-btn shadow-hover">
                <i class="fas fa-plus-circle mb-2" style="font-size:2rem;"></i>
                <span>Add Property</span>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Landlord" asp-action="MyProperties" class="btn btn-gradient-blue quick-action-btn shadow-hover">
                <i class="fas fa-list mb-2" style="font-size:2rem;"></i>
                <span>My Properties</span>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Landlord" asp-action="TenantRequests" class="btn btn-gradient-green quick-action-btn shadow-hover">
                <i class="fas fa-users mb-2" style="font-size:2rem;"></i>
                <span>Tenant Requests</span>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-gradient-yellow quick-action-btn shadow-hover">
                <i class="fas fa-chart-line mb-2" style="font-size:2rem;"></i>
                <span>Reports</span>
            </a>
        </div>
        <div class="col-md-3 col-6">
            <a asp-controller="Landlord" asp-action="Tenants" class="btn btn-gradient-purple quick-action-btn shadow-hover">
                <i class="fas fa-eye mb-2" style="font-size:2rem;"></i>
                <span>View Your Tenants</span>
            </a>
        </div>
    </div>

    <!-- Properties Overview Header Ribbon -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="header-ribbon">
                <span>Your Properties</span>
            </div>
        </div>
    </div>

    <!-- Properties Overview Cards -->
    <div class="row">
        @if (ViewBag.Properties != null && ViewBag.Properties.Count > 0)
        {
            foreach (var property in ViewBag.Properties)
            {
                var images = property.Images as List<PropertyImage> ?? new List<PropertyImage>();
                var imageUrl = images.Any() ? images.First().ImageUrl : "/images/default-property.jpg";

                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border rounded-3 hover-shadow h-100">
                                <img src="@imageUrl"
                                     class="card-img-top"
                                     alt="@property.Title"
                                     style="height:200px; object-fit:cover;" />
                                <div class="card-body">
                                    <h5 class="card-title">@property.Title</h5>
                                    <p class="card-text text-truncate">@property.Description</p>
                                    <p class="mb-1"><i class="fas fa-dollar-sign me-1"></i> @property.Rent</p>
                                    <div class="d-flex justify-content-between">
                                        <a asp-controller="Landlord" asp-action="EditProperty" asp-route-id="@property.Id"
                                           class="btn btn-sm btn-outline-primary">Edit</a>
                                        <form asp-controller="Landlord" asp-action="DeleteProperty"
                                              asp-route-id="@property.Id" method="post"
                                              onsubmit="return confirm('Are you sure?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                        <a asp-controller="Landlord" asp-action="UpdateImages" 
                                           asp-route-propertyId="@property.Id" 
                                           class="btn btn-sm btn-outline-success">Images</a>
                                    </div>
                                </div>
                            </div>
                        </div>
            }
        }
        else
        {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3 text-center py-5">
                        <i class="fas fa-home text-muted mb-3" style="font-size:3rem;"></i>
                        <p class="mb-2">No properties listed yet</p>
                        <a asp-controller="Landlord" asp-action="AddProperty" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add Your First Property
                        </a>
                    </div>
                </div>
        }
    </div>
</div>

<style>
/* Modern Sleek Dashboard Header */
.dashboard-header {
    width: 100%;
    background: linear-gradient(90deg, #6a11cb 0%, #2575fc 100%); /* smooth gradient */
    color: #fff;
    padding: 25px 30px;
    border-radius: 10px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Poppins', sans-serif;
}

.dashboard-header h1 {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0;
}

.dashboard-header p {
    font-size: 1rem;
    opacity: 0.85;
    margin: 0;
}

.dashboard-header .header-icon {
    font-size: 2.2rem;
    margin-right: 15px;
}


/* Stats Cards Hover */
.stats-card { transition: transform 0.3s, box-shadow 0.3s; }
.stats-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.25); }

/* Gradient Buttons */
.btn-gradient-purple { background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); color: white; font-weight:600; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; }
.btn-gradient-blue { background: linear-gradient(135deg, #1c92d2 0%, #f2fcfe 100%); color: white; font-weight:600; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; }
.btn-gradient-green { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; font-weight:600; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; }
.btn-gradient-yellow { background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color: white; font-weight:600; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; }

/* Quick Action Buttons Height & Hover */
.quick-action-btn { min-height: 160px; margin-bottom: 15px; transition: all 0.3s; border-radius:10px; }
.shadow-hover:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(0,0,0,0.3); }

/* Properties Hover */
.hover-shadow:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.25); }

/* Notification Dot */
.pending-dot { position: absolute; top: 10px; right: 15px; width: 12px; height: 12px; background-color: red; border-radius: 50%; box-shadow: 0 0 5px rgba(0,0,0,0.3); }
</style>
