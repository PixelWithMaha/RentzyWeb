@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@{
    ViewData["Title"] = "Landlord Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-gradient text-white py-4" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h2 class="mb-0">
                        <i class="fas fa-building me-2"></i>Welcome, @ViewBag.UserName!
                    </h2>
                    <p class="mb-0 opacity-75">Landlord Dashboard</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Quick Stats -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-home text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Total Properties</h5>
                    <h2 class="text-primary mb-0">0</h2>
                    <p class="text-muted small">Listed Properties</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-users text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Active Tenants</h5>
                    <h2 class="text-success mb-0">0</h2>
                    <p class="text-muted small">Current Tenants</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-dollar-sign text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Monthly Revenue</h5>
                    <h2 class="text-warning mb-0">$0</h2>
                    <p class="text-muted small">This Month</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-clipboard-list text-info" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="card-title">Pending Requests</h5>
                    <h2 class="text-info mb-0">0</h2>
                    <p class="text-muted small">Awaiting Response</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2 text-primary"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <a href="#" class="btn btn-primary w-100 py-3">
                                <i class="fas fa-plus-circle d-block mb-2" style="font-size: 2rem;"></i>
                                Add Property
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="#" class="btn btn-outline-secondary w-100 py-3">
                                <i class="fas fa-list d-block mb-2" style="font-size: 2rem;"></i>
                                My Properties
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-info w-100 py-3">
                                <i class="fas fa-user d-block mb-2" style="font-size: 2rem;"></i>
                                My Profile
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="#" class="btn btn-outline-success w-100 py-3">
                                <i class="fas fa-chart-line d-block mb-2" style="font-size: 2rem;"></i>
                                View Reports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Properties Overview -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-building me-2 text-primary"></i>Your Properties
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-home" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="mt-3">No properties listed yet</p>
                        <a href="#" class="btn btn-primary mt-2">
                            <i class="fas fa-plus me-2"></i>Add Your First Property
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>