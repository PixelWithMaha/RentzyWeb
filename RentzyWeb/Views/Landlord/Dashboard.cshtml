@{
    ViewData["Title"] = "Landlord Dashboard";
}

@using Rentzy.DAL.Models
@using System.Linq

<div class="container my-5">

    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); color:white;">
                    <div>
                        <h2 class="mb-1"><i class="fas fa-building me-2"></i>Welcome, @ViewBag.UserName!</h2>
                        <p class="mb-0 opacity-75">Landlord Dashboard</p>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-lg shadow-sm">
                            <i class="fas fa-user me-2"></i>My Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-0 rounded-3 hover-shadow p-3 text-center">
                <i class="fas fa-home text-primary mb-2" style="font-size:2.5rem;"></i>
                <h5>Total Properties</h5>
                <h3 class="text-primary">@ViewBag.TotalProperties </h3>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-0 rounded-3 hover-shadow p-3 text-center">
                <i class="fas fa-users text-success mb-2" style="font-size:2.5rem;"></i>
                <h5>Active Tenants</h5>
                <h3 class="text-success">@ViewBag.ActiveTenants ?? 0</h3>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-0 rounded-3 hover-shadow p-3 text-center">
                <i class="fas fa-dollar-sign text-warning mb-2" style="font-size:2.5rem;"></i>
                <h5>Monthly Revenue</h5>
                <h3 class="text-warning">$@ViewBag.MonthlyRevenue ?? 0</h3>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-0 rounded-3 hover-shadow p-3 text-center">
                <i class="fas fa-clipboard-list text-info mb-2" style="font-size:2.5rem;"></i>
                <h5>Pending Requests</h5>
                <h3 class="text-info">@ViewBag.PendingRequests ?? 0</h3>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2 text-primary"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <a asp-controller="Landlord" asp-action="AddProperty"
                               class="btn btn-primary w-100 py-3 hover-scale shadow">
                                <i class="fas fa-plus-circle d-block mb-2" style="font-size:2rem;"></i>
                                Add Property
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a asp-controller="Landlord" asp-action="MyProperties"
                               class="btn btn-outline-secondary w-100 py-3 hover-scale shadow">
                                <i class="fas fa-list d-block mb-2" style="font-size:2rem;"></i>
                                My Properties
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a asp-controller="Landlord" asp-action="TenantRequests"
                               class="btn btn-outline-success w-100 py-3 hover-scale shadow">
                                <i class="fas fa-users d-block mb-2" style="font-size:2rem;"></i>
                                Tenant Requests
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a asp-controller="Reports" asp-action="Index"
                               class="btn btn-outline-info w-100 py-3 hover-scale shadow">
                                <i class="fas fa-chart-line d-block mb-2" style="font-size:2rem;"></i>
                                Reports
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Properties Overview -->
    <div class="row">
        @if (ViewBag.Properties != null && ViewBag.Properties.Count > 0)
        {
            foreach (var property in ViewBag.Properties)
            {
                // Cast images list strongly or treat as empty list
                var images = property.Images as List<PropertyImage> ?? new List<PropertyImage>();
                var imageUrl = images.Any() ? images.First().ImageUrl : "/images/default-property.jpg";

                        <div class="col-md-4 mb-4">
                            <div class="card shadow-sm border-0 rounded-3 hover-shadow h-100">
                                <img src="@imageUrl"
                                     class="card-img-top"
                                     alt="@property.Title"
                                     style="height:200px; object-fit:cover;" />

                                <div class="card-body">
                                    <h5 class="card-title">@property.Title</h5>
                                    <p class="card-text text-truncate">@property.Description</p>
                                    <p class="mb-1"><i class="fas fa-dollar-sign me-1"></i> @property.Rent</p>

                                    <div class="d-flex justify-content-between">
                                        <a asp-controller="Landlord" asp-action="EditProperty" asp-route-id="@property.Id"
                                           class="btn btn-sm btn-outline-primary">Edit</a>

                                        <form asp-controller="Landlord" asp-action="DeleteProperty"
                                              asp-route-id="@property.Id" method="post"
                                              onsubmit="return confirm('Are you sure?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>

                                                <a asp-controller="Landlord" asp-action="UpdateImages" 
           asp-route-propertyId="@property.Id" 
           class="btn btn-sm btn-outline-success">Images</a>

                                    </div>
                                </div>
                            </div>
                        </div>
            }
        }
        else
        {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3 text-center py-5">
                        <i class="fas fa-home text-muted mb-3" style="font-size:3rem;"></i>
                        <p class="mb-2">No properties listed yet</p>
                        <a asp-controller="Landlord" asp-action="AddProperty" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add Your First Property
                        </a>
                    </div>
                </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.15);
        transition: box-shadow 0.3s ease-in-out;
    }

    .hover-scale:hover {
        transform: scale(1.05);
        transition: transform 0.3s ease-in-out;
    }

    .card-body a.btn {
        font-weight: 500;
    }
</style>
