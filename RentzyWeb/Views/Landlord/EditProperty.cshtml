@model Rentzy.BLL.DTOs.PropertyDTO
@{
    ViewData["Title"] = "Edit Property";
}

<div class="container my-5">
    <h2 class="mb-4 text-center">Edit Property</h2>

    <form asp-action="EditProperty" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Rent" class="form-label">Rent</label>
            <input asp-for="Rent" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CityId" class="form-label">City</label>
            <select asp-for="CityId" class="form-select" asp-items="@(new SelectList(ViewBag.Cities, "Id", "Name"))"></select>
        </div>

        <div class="mb-3">
            <label asp-for="PropertyTypeId" class="form-label">Property Type</label>
            <select asp-for="PropertyTypeId" class="form-select" asp-items="@(new SelectList(ViewBag.PropertyTypes, "Id", "Name"))"></select>
        </div>

        <div class="mb-4">
            <a asp-controller="Landlord" asp-action="UpdateImages" asp-route-propertyId="@Model.Id" class="btn btn-outline-info btn-lg w-100 hover-scale">
                <i class="fas fa-image me-2"></i> Update Images
            </a>
        </div>

        <button type="submit" class="btn btn-primary btn-lg w-100 hover-scale">Update Property</button>
    </form>
</div>

<style>
    .hover-scale:hover {
        transform: scale(1.03);
        transition: transform 0.3s ease-in-out;
    }
    .form-label {
        font-weight: 500;
    }
</style>
