@model IEnumerable<Rentzy.BLL.DTOs.ReviewDTO>

@{
    ViewData["Title"] = "Property Reviews";
}

<div class="container py-5">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold" style="color: var(--theme-text); font-family: 'Poppins', sans-serif;">
                <i class="fas fa-comments text-warning me-2"></i>Portfolio Feedback
            </h2>
            <p class="text-muted mb-0">Observe your asset utilization and client sentiment tracking.</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Dashboard" class="btn btn-outline-primary rounded-pill border-2 px-4 shadow-sm transition-fast">
                <i class="fas fa-arrow-left me-2"></i>Control Dashboard
            </a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border" style="background: var(--theme-card-bg) !important; color: var(--theme-text);">
            <img src="https://cdn-icons-png.flaticon.com/512/4121/4121022.png" style="width: 120px; filter: grayscale(0.6); opacity: 0.7;" class="mb-4" alt="No reviews" />
            <h4 class="fw-semibold">No Direct Feedback Found</h4>
            <p class="text-muted px-3">Your properties haven't accumulated tenant commentary yet. Finalize more transactions to boost exposure.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var review in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm position-relative hover-effect" 
                         style="border-radius: 1.25rem; background: var(--theme-card-bg); overflow: hidden;">
                        
                        <!-- Top Accent Bar mapping to stars -->
                        @{
                            string topBarColor = review.Rating >= 4 ? "#10b981" : (review.Rating >= 3 ? "#f59e0b" : "#ef4444");
                        }
                        <div style="height: 6px; background: @topBarColor;"></div>

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="text-primary fw-bold mb-0 text-truncate" style="max-width: 150px;" title="@review.PropertyTitle">
                                        @review.PropertyTitle
                                    </h6>
                                    <small class="text-muted">Prop ID: @review.PropertyId</small>
                                </div>
                                <div class="d-flex flex-column align-items-end">
                                    <div class="text-warning fs-5 mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="@(i <= review.Rating ? "fas fa-star" : "far fa-star")"></i>
                                        }
                                    </div>
                                    <small class="badge rounded-pill bg-light text-dark border text-xs">
                                        @review.CreatedAt.ToString("MMM d, yy")
                                    </small>
                                </div>
                            </div>

                            <div class="p-3 rounded-3 mb-3 flex-grow-1" 
                                 style="background: rgba(0,0,0,0.03); font-style: italic; color: var(--theme-text);">
                                "@review.Comment"
                            </div>

                            <hr class="my-3 opacity-10">

                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold me-2" 
                                     style="width: 36px; height: 36px; font-size: 0.85rem;">
                                    @(string.IsNullOrEmpty(review.TenantName) || review.TenantName.Length < 1 ? "U" : review.TenantName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div class="small fw-bold" style="color: var(--theme-text);">@review.TenantName</div>
                                    <small class="text-muted text-xs">Verified Past Renter</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-fast {
        transition: all 0.2s ease;
    }
    .hover-effect {
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }
    .hover-effect:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
    }
    .text-xs {
        font-size: 0.75rem;
    }
</style>
