@model Rentzy.BLL.DTOs.PropertyDTO
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Update Property Images";
    var propertyId = Model.Id;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<h2 class="text-center my-4 fw-bold text-primary" style="font-size:2rem; letter-spacing:0.5px;">
    Update Images for <span>@Model.Title</span>
</h2>

<div class="container">
    <div class="mb-4">
    <label for="imageFiles"  class="form-label fw-semibold" style="font-size:1.1rem;">
        Add Images
    </label>
    <input type="file" id="imageFiles" name="imageFiles" class="form-control shadow-sm" multiple accept="image/*,.jpg,.jpeg,.png,.gif,.webp" />
    <small class="text-muted">You can select multiple images (jpg, png, gif, webp). Max 5 MB each.</small>
</div>

    <div id="previewImages" class="d-flex flex-wrap gap-3 mb-4">
        @if (Model.Images != null)
        {
            foreach (var img in Model.Images)
            {
                        <div class="position-relative image-card" data-image-id="@img.Id">
                            <img src="@img.ImageUrl" class="img-thumbnail image-thumb" />
                            <button type="button"
                                    class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn"
                                    data-url="@img.ImageUrl">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
            }
        }
    </div>

    <div class="d-flex justify-content-end">
        <a asp-controller="Landlord" asp-action="EditProperty" asp-route-id="@propertyId" 
           class="btn btn-success btn-lg shadow-sm fw-semibold text-white px-4 py-2 hover-scale">
            Done
        </a>
    </div>
</div>

<style>
/* Header and labels improvements */
h2 {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
.form-label {
    letter-spacing: 0.3px;
}
small.text-muted {
    font-size: 0.9rem;
}

/* Buttons */
.hover-scale:hover {
    transform: scale(1.05);
    transition: transform 0.3s ease-in-out;
}

/* Keep existing image hover styles intact */
.image-card {
    width: 180px;
    height: 180px;
    overflow: hidden;
    border-radius: 12px;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.image-card:hover {
    transform: scale(1.05);
    box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.25);
}
.image-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}
.image-card:hover .image-thumb {
    transform: scale(1.1);
}
.delete-image-btn {
    opacity: 0;
    transition: opacity 0.3s ease;
}
.image-card:hover .delete-image-btn {
    opacity: 1;
}
#imageFiles::file-selector-button {
    background-color: #0d6efd; /* Bootstrap primary blue */
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    margin-right: 10px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.3s ease;
}

#imageFiles::file-selector-button:hover {
    background-color: #0b5ed7; /* Slightly darker blue on hover */
}
</style>

<script>
    (function () {
        const input = document.getElementById('imageFiles');
        const preview = document.getElementById('previewImages');
        const propertyId = '@propertyId';
        const afToken = '@token';
        const maxSize = 5 * 1024 * 1024; // 5MB
        const allowed = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

        function createImageCard(id, url) {
            const div = document.createElement('div');
            div.className = 'position-relative image-card';
            if (id) div.setAttribute('data-image-id', id);

            const img = document.createElement('img');
            img.src = url;
            img.className = 'img-thumbnail image-thumb';

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn';
            btn.innerHTML = '<i class="fas fa-times"></i>';
            btn.addEventListener('click', onDeleteClick);

            div.appendChild(img);
            div.appendChild(btn);
            return div;
        }

        async function onDeleteClick(e) {
            const card = e.currentTarget.closest('.image-card');
            const imageId = card?.getAttribute('data-image-id');

            if (!imageId) {
                // image not saved on server yet - just remove preview
                card.remove();
                return;
            }

            if (!confirm('Delete this image?')) return;

            const form = new FormData();
            form.append('imageId', imageId);

            try {
                const resp = await fetch('/Landlord/DeletePropertyImage', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': afToken
                    },
                    body: form
                });

                if (resp.ok) {
                    card.remove();
                } else {
                    alert('Failed to delete image');
                }
            } catch (err) {
                console.error(err);
                alert('Failed to delete image');
            }
        }

        input && input.addEventListener('change', async function (ev) {
            const files = Array.from(ev.target.files || []);
            if (!files.length) return;

            const validFiles = [];
            for (const f of files) {
                const ext = (f.name.match(/\.[0-9a-z]+$/i) || [''])[0].toLowerCase();
                if (!allowed.includes(ext)) continue;
                if (!f.type.startsWith('image/')) continue;
                if (f.size === 0 || f.size > maxSize) continue;
                validFiles.push(f);
            }

            if (!validFiles.length) {
                alert('No valid images selected. Only jpg, png, gif, webp under 5 MB are allowed.');
                input.value = '';
                return;
            }

            const form = new FormData();
            for (const f of validFiles) form.append('imageFiles', f);

            try {
                const resp = await fetch(`/Landlord/UploadNewImages?propertyId=${propertyId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': afToken
                    },
                    body: form
                });

                if (!resp.ok) {
                    const txt = await resp.text();
                    alert('Upload failed: ' + txt);
                    return;
                }

                const data = await resp.json();
                // data = [{ id, url }, ...]
                for (const item of data) {
                    const card = createImageCard(item.id, item.url);
                    preview.appendChild(card);
                }

                input.value = '';
            } catch (err) {
                console.error(err);
                alert('Upload failed');
            }
        });

        // Attach delete handlers to existing images
        document.querySelectorAll('.delete-image-btn').forEach(btn => btn.addEventListener('click', onDeleteClick));
    })();
</script>

