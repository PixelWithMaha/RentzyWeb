@model Rentzy.BLL.DTOs.PropertyDTO
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Update Property Images";
    var propertyId = Model.Id;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<h2 class="text-center my-4">Update Images for @Model.Title</h2>

<div class="container">
    <div class="mb-3">
        <label for="imageFiles" class="form-label">Add Images</label>
        <input type="file" id="imageFiles" class="form-control" multiple />
    </div>

    <div id="previewImages" class="d-flex flex-wrap gap-3 mb-3">
        @if (Model.Images != null)
        {
            foreach (var img in Model.Images)
            {
                    <div class="position-relative image-card" data-image-id="@img.Id">
                        <img src="@img.ImageUrl" class="img-thumbnail image-thumb" />
                        <button type="button"
                                class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn"
                                data-url="@img.ImageUrl">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
            }
        }
</div>


    <div class="d-flex justify-content-end">
        <a asp-controller="Landlord" asp-action="EditProperty" asp-route-id="@propertyId" class="btn btn-success">
            Done
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const propertyId = @propertyId;
        const token = '@token';

        // Handle file uploads
        document.getElementById('imageFiles').addEventListener('change', async function (e) {
            const files = e.target.files;
            if (!files.length) return;

            const formData = new FormData();
            for (let f of files) formData.append('imageFiles', f);
            formData.append('__RequestVerificationToken', token);

            const response = await fetch(`/Landlord/UploadNewImages?propertyId=${propertyId}`, {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                const previewDiv = document.getElementById('previewImages');

                data.forEach(img => {
                    const div = document.createElement('div');
                    div.className = 'position-relative';
                    div.style.width = '150px';
                    div.style.height = '150px';
                    div.dataset.imageId = img.id; // backend should return {id, url}

                    div.innerHTML = `
                        <img src="${img.url}" class="img-thumbnail" style="width:100%; height:100%; object-fit:cover;" />
                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-image-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    `;
                    previewDiv.appendChild(div);
                });
            } else {
                alert('Upload failed');
            }
        });

        // Delete image
        document.getElementById('previewImages').addEventListener('click', async function (e) {
            if (e.target.closest('.delete-image-btn')) {
                const btn = e.target.closest('.delete-image-btn');
                const container = btn.parentElement;
                const imageId = container.dataset.imageId;

                if (!confirm('Delete this image?')) return;

                const formData = new FormData();
                formData.append('imageId', imageId);
                formData.append('__RequestVerificationToken', token);

                const response = await fetch(`/Landlord/DeletePropertyImage`, {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    container.remove();
                } else {
                    alert('Delete failed');
                }
            }
        });
    </script>
}

<style>
.image-card {
    width: 180px;
    height: 180px;
    overflow: hidden;
    border-radius: 12px;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.image-card:hover {
    transform: scale(1.05);
    box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.25);
}
.image-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}
.image-card:hover .image-thumb {
    transform: scale(1.1);
}
.delete-image-btn {
    opacity: 0;
    transition: opacity 0.3s ease;
}
.image-card:hover .delete-image-btn {
    opacity: 1;
}
</style>

