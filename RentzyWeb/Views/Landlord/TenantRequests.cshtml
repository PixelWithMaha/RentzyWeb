@model List<Rentzy.BLL.DTOs.BookingDTOs.PropertyRentalRequestDto>
@{
    ViewData["Title"] = "Tenant Requests";
}

@Html.AntiForgeryToken()

<div class="container my-5">

    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-header">
                <div class="header-content">
                    <h1><i class="fas fa-users me-2"></i>Tenant Requests</h1>
                    <p>Review and manage rental requests from tenants</p>
                </div>
                <div class="header-stats">
                    <div class="stat-badge">
                        <span class="stat-number">@Model.Count</span>
                        <span class="stat-label">Total Requests</span>
                    </div>
                    <div class="stat-badge">
                        <span class="stat-number">@Model.Count(r => r.RequestedAt.Date == DateTime.Today)</span>
                        <span class="stat-label">Today</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Grid -->
    <div class="requests-grid">
        @if (Model.Any())
        {
            @foreach (var req in Model)
            {
                        <div class="request-card" id="row-@req.Id">
                            <!-- Request Header -->
                            <div class="request-header">
                                <div class="request-badge">
                                    <i class="fas fa-clock"></i>
                                    <span>Pending</span>
                                </div>
                                <div class="request-date">
                                    <i class="fas fa-calendar-plus"></i>
                                    <span>@req.RequestedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>

                            <!-- Request Content -->
                            <div class="request-content">
                                <!-- Tenant Info -->
                                <div class="tenant-section">
                                    <div class="tenant-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="tenant-info">
                                        <h3 class="tenant-name">@req.TenantName</h3>
                                        <p class="request-time">Requested @req.RequestedAt.ToString("h:mm tt")</p>
                                    </div>
                                </div>

                                <!-- Property Info -->
                                <div class="property-section">
                                    <div class="property-icon">
                                        <i class="fas fa-home"></i>
                                    </div>
                                    <div class="property-info">
                                        <h4 class="property-title">@req.PropertyTitle</h4>
                                        <p class="property-dates">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                    @req.StartDate.ToString("dd MMM yyyy") — @req.EndDate.ToString("dd MMM yyyy")
                                        </p>
                                        <p class="stay-duration">
                                    @((req.EndDate - req.StartDate).Days) night@((req.EndDate - req.StartDate).Days != 1 ? "s" : "")
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="request-actions">
                                <button class="btn-action btn-approve" data-id="@req.Id">
                                    <i class="fas fa-check me-2"></i>
                                    Approve Request
                                </button>
                                <button class="btn-action btn-reject" data-id="@req.Id">
                                    <i class="fas fa-times me-2"></i>
                                    Reject Request
                                </button>
                            </div>
                        </div>
            }
        }
        else
        {
                <!-- Empty State -->
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h3>No Pending Requests</h3>
                    <p>You don't have any tenant requests at the moment</p>
                    <div class="empty-actions">
                        <a href="@Url.Action("MyProperties", "Landlord")" class="btn-primary">
                            <i class="fas fa-home me-2"></i>View Properties
                        </a>
                    </div>
                </div>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        const token = $('input[name="__RequestVerificationToken"]').val();

        function updateRequest(actionUrl, requestId, row) {
            $.ajax({
                url: actionUrl,
                type: 'POST',
                headers: { "RequestVerificationToken": token },
                data: { requestId: requestId },
                success: function () {
                    // Add success animation before removing
                    row.addClass('request-completed');
                    setTimeout(function () {
                        row.fadeOut(500, function () { 
                            $(this).remove(); 
                            // Check if no requests left
                            if ($('.request-card').length === 0) {
                                location.reload();
                            }
                        });
                    }, 1000);
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                }
            });
        }

        $(document).on("click", ".btn-approve", function () {
            const requestId = $(this).data("id");
            const row = $("#row-" + requestId);
            if (confirm('Are you sure you want to approve this rental request?')) {
                updateRequest('@Url.Action("ApproveRequest", "Landlord")', requestId, row);
            }
        });

        $(document).on("click", ".btn-reject", function () {
            const requestId = $(this).data("id");
            const row = $("#row-" + requestId);
            if (confirm('Are you sure you want to reject this rental request?')) {
                updateRequest('@Url.Action("RejectRequest", "Landlord")', requestId, row);
            }
        });
    });
</script>

<style>
    :root {
        --primary-blue: #1e3a8a;
        --medium-blue: #3b82f6;
        --light-blue: rgba(59, 130, 246, 0.1);
        --purple: #6a11cb;
        --accent-blue: #2575fc;
        --white: var(--theme-card-bg);
        --light-bg: var(--theme-hero-bg);
        --dark-text: var(--theme-text);
        --gray-text: var(--theme-text-muted);
        --border-light: var(--theme-border);
        --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
    }

    /* Dashboard Header */
    .dashboard-header {
        background: linear-gradient(135deg, var(--purple) 0%, var(--accent-blue) 100%);
        border-radius: 16px;
        padding: 30px;
        color: var(--white);
        box-shadow: var(--shadow-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .dashboard-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
    }

    .header-content h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
    }

    .header-content p {
        font-size: 1.1rem;
        opacity: 0.9;
        margin: 0;
    }

    /* Header Stats */
    .header-stats {
        display: flex;
        gap: 20px;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        padding: 15px 20px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .stat-number {
        display: block;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.9rem;
        opacity: 0.9;
    }

    /* Requests Grid */
    .requests-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 20px;
    }

    /* Request Card */
    .request-card {
        background: var(--white);
        border-radius: 16px;
        padding: 25px;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .request-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(to bottom, var(--warning), #fbbf24);
    }

    .request-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
    }

    /* Request Header */
    .request-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .request-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #fef3c7;
        color: #92400e;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .request-badge i {
        font-size: 0.7rem;
    }

    .request-date {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--gray-text);
        font-size: 0.85rem;
    }

    /* Request Content */
    .request-content {
        margin-bottom: 20px;
    }

    /* Tenant Section */
    .tenant-section {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border-light);
    }

    .tenant-avatar {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--purple), var(--accent-blue));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .tenant-info {
        flex: 1;
    }

    .tenant-name {
        font-size: 1.2rem;
        font-weight: 600;
        color: var(--dark-text);
        margin: 0 0 4px 0;
    }

    .request-time {
        font-size: 0.85rem;
        color: var(--gray-text);
        margin: 0;
    }

    /* Property Section */
    .property-section {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .property-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--light-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--medium-blue);
        font-size: 1rem;
        flex-shrink: 0;
    }

    .property-info {
        flex: 1;
    }

    .property-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--dark-text);
        margin: 0 0 8px 0;
    }

    .property-dates {
        font-size: 0.9rem;
        color: var(--gray-text);
        margin: 0 0 4px 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .stay-duration {
        font-size: 0.8rem;
        color: var(--medium-blue);
        font-weight: 500;
        margin: 0;
    }

    /* Request Actions */
    .request-actions {
        display: flex;
        gap: 10px;
    }

    .btn-action {
        flex: 1;
        padding: 12px 16px;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-approve {
        background: linear-gradient(135deg, var(--success), #34d399);
        color: white;
    }

    .btn-reject {
        background: linear-gradient(135deg, var(--danger), #f87171);
        color: white;
    }

    .btn-action:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
    }

    /* Empty State */
    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 80px 20px;
        background: var(--white);
        border-radius: 16px;
        box-shadow: var(--shadow);
    }

    .empty-state i {
        font-size: 4rem;
        color: var(--gray-text);
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 1.5rem;
        color: var(--dark-text);
        margin-bottom: 10px;
    }

    .empty-state p {
        color: var(--gray-text);
        margin-bottom: 30px;
    }

    .empty-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--purple), var(--accent-blue));
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
        color: white;
    }

    /* Animation for completed requests */
    .request-completed {
        background: linear-gradient(135deg, #d1fae5, #ecfdf5);
        border-color: #10b981;
    }

    .request-completed::before {
        background: linear-gradient(to bottom, #10b981, #34d399);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .header-stats {
            justify-content: center;
        }

        .requests-grid {
            grid-template-columns: 1fr;
        }

        .request-actions {
            flex-direction: column;
        }

        .empty-actions {
            flex-direction: column;
            align-items: center;
        }
    }

    @@media (max-width: 480px) {
        .request-card {
            padding: 20px;
        }

        .tenant-section, .property-section {
            flex-direction: column;
            text-align: center;
            gap: 10px;
        }

        .tenant-avatar, .property-icon {
            align-self: center;
        }
    }
</style>