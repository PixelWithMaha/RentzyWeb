@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rentzy</title>

    <!-- Theme Initialize Script (Immediate) -->
    <script>
        (function () {
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
            if (theme === 'dark') document.documentElement.classList.add('dark');
        })();
    </script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        themeBase: 'var(--theme-bg)',
                        themeNav: 'var(--theme-nav-bg)',
                        themeCard: 'var(--theme-card-bg)',
                        themeText: 'var(--theme-text)',
                        themeMuted: 'var(--theme-text-muted)',
                        themeBorder: 'var(--theme-border)'
                    }
                }
            }
        }
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }

        .navbar-modern {
            background-color: var(--theme-nav-bg);
            border-bottom: 1px solid var(--theme-nav-border);
            box-shadow: 0 1px 4px var(--theme-nav-border);
            padding: 0.75rem 0;
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        .navbar-brand-modern {
            font-size: 1.8rem;
            font-weight: 700;
            color: #3B82F6;
            text-decoration: none;
        }

        .nav-link-modern {
            color: var(--theme-text-muted);
            font-weight: 500;
            padding: 0.4rem 0.8rem;
            text-decoration: none;
            transition: all 0.3s;
            border-radius: 0.5rem;
            font-size: 1rem;
        }

            .nav-link-modern:hover {
                color: #3B82F6;
                background-color: rgba(59, 130, 246, 0.1);
            }

        .btn-login-modern, .btn-register-modern {
            padding: 0.5rem 1.25rem;
            font-size: 1rem;
            line-height: 1.5;
            border-radius: 0.75rem;
        }

        .btn-login-modern {
            color: #3B82F6;
            font-weight: 600;
            border: 2px solid #3B82F6;
            background: transparent;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-login-modern:hover {
                background-color: rgba(59, 130, 246, 0.1);
                color: #2563EB;
            }

        .btn-register-modern {
            background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
            color: white !important;
            font-weight: 600;
            border: none;
            box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-register-modern:hover {
                background: linear-gradient(135deg, #2563EB 0%, #1d4ed8 100%);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.5);
            }

        .theme-toggle-pill {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.85rem;
            border-radius: 0.75rem;
            border: 1px solid var(--theme-border);
            background: transparent;
            color: var(--theme-text-muted);
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .theme-toggle-pill:hover {
                background-color: rgba(59, 130, 246, 0.05);
                border-color: #3B82F6;
                color: #3B82F6;
            }

        .dark-icon, .light-icon {
            display: none;
        }

        [data-bs-theme='dark'] .dark-icon {
            display: inline-block;
        }

        [data-bs-theme='light'] .light-icon {
            display: inline-block;
        }

        .user-dropdown {
            position: relative;
        }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 2px);
            background: var(--theme-card-bg);
            min-width: 200px;
            box-shadow: var(--theme-shadow);
            border: 1px solid var(--theme-border);
            border-radius: 0.5rem;
            z-index: 1000;
            padding: 0.5rem 0;
            transition: background-color 0.3s ease;
        }

            .user-dropdown:hover .dropdown-menu-custom,
            .dropdown-menu-custom:hover {
                display: block;
            }

        .user-dropdown::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            height: 10px;
            background: transparent;
        }

        .dropdown-item-custom {
            display: block;
            padding: 0.6rem 1rem;
            color: var(--theme-text-muted);
            text-decoration: none;
            transition: all 0.2s;
            font-size: 0.95rem;
        }

            .dropdown-item-custom:hover {
                background-color: rgba(59, 130, 246, 0.1);
                color: #3B82F6;
            }

        .dropdown-divider-custom {
            height: 1px;
            background-color: var(--theme-border);
            margin: 0.5rem 0;
        }

        .user-badge {
            display: inline-block;
            padding: 0.2rem 0.6rem;
            font-size: 0.7rem;
            font-weight: 600;
            border-radius: 1rem;
            background-color: #DBEAFE;
            color: #1E40AF;
        }

        .alert {
            background-color: var(--theme-card-bg);
            border-color: var(--theme-border);
            color: var(--theme-text);
        }

        .alert-success {
            border-left: 4px solid #10b981;
        }

        .alert-danger {
            border-left: 4px solid #ef4444;
        }

        .footer-custom {
            background-color: #1F2937;
            color: white;
            padding: 1rem 0;
        }

        .footer-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

            .footer-content p {
                margin-bottom: 0.5rem;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar-modern">
            <div class="container-fluid px-4">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <a asp-controller="Home" asp-action="Index" class="navbar-brand-modern">
                            <i class="fas fa-home me-2"></i>Rentzy
                        </a>
                    </div>

                    <div class="d-flex align-items-center" style="gap: 1rem;">
                        <button onclick="toggleTheme()" class="theme-toggle-pill" aria-label="Toggle theme">
                            <span class="light-icon"><i class="fas fa-sun me-2"></i>Light</span>
                            <span class="dark-icon"><i class="fas fa-moon me-2"></i>Dark</span>
                        </button>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            var userType = Context.Session.GetString("UserType");

                            <a asp-controller="Home" asp-action="Index" class="nav-link-modern">
                                <i class="fas fa-home me-1"></i>Home
                            </a>

                            @if (userType == "Landlord")
                            {
                                <a asp-controller="Landlord" asp-action="MyProperties" class="nav-link-modern">
                                    <i class="fas fa-building me-1"></i>Properties
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Property" asp-action="Index" class="nav-link-modern">
                                    <i class="fas fa-building me-1"></i>Properties
                                </a>
                            }

                            @if (userType == "Tenant")
                            {
                                <a asp-controller="Notification" asp-action="Index" class="nav-link-modern position-relative">
                                    <i class="fas fa-bell me-1"></i>Notifications
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge bg-danger d-none" style="font-size: 0.6rem;">
                                        !
                                    </span>
                                </a>
                                <a asp-controller="Tenant" asp-action="Dashboard" class="nav-link-modern">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            }
                            else if (userType == "Landlord")
                            {
                                <a asp-controller="Landlord" asp-action="Dashboard" class="nav-link-modern">
                                    <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            }
                            else if (userType == "Admin")
                            {
                                <a asp-controller="Admin" asp-action="Dashboard" class="nav-link-modern">
                                    <i class="fas fa-user-shield me-1"></i>Admin
                                </a>
                            }

                            <div class="user-dropdown">
                                <button class="btn btn-outline-primary d-flex align-items-center" style="gap: 0.4rem;">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@Context.Session.GetString("UserName")</span>
                                    <span class="user-badge">@userType</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>

                                <div class="dropdown-menu-custom">
                                    <a asp-controller="Account" asp-action="Profile" class="dropdown-item-custom">
                                        <i class="bi bi-person me-2"></i>My Profile
                                    </a>
                                    <a asp-controller="Account" asp-action="EditProfile" class="dropdown-item-custom">
                                        <i class="bi bi-pencil me-2"></i>Edit Profile
                                    </a>
                                    <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item-custom">
                                        <i class="bi bi-key me-2"></i>Change Password
                                    </a>
                                    <div class="dropdown-divider-custom"></div>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item-custom w-100 text-start border-0 bg-transparent text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index" class="nav-link-modern">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                            <a asp-controller="Property" asp-action="Index" class="nav-link-modern">
                                <i class="fas fa-building me-1"></i>Properties
                            </a>
                            <a asp-controller="Account" asp-action="Login" class="btn-login-modern">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn-register-modern">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mx-auto px-4">
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mx-auto px-4">
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto">
        <div class="footer-content px-2">
            <p class="mb-2">&copy; 2024 - Rentzy - Rental Management Simplified</p>
            <p class="text-sm" style="color: #9CA3AF;">
                Securely powered by ASP.NET Core MVC and SQL Server
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const notificationBadge = document.getElementById('notificationBadge');
            if (notificationBadge) {
                fetch('@Url.Action("CheckNotifications", "Notification")')
                    .then(response => response.json())
                    .then(data => {
                        if (data.authenticated && data.hasNotifications) {
                            notificationBadge.textContent = data.count > 9 ? '9+' : data.count;
                            notificationBadge.classList.remove('d-none');
                        }
                    })
                    .catch(() => notificationBadge.classList.add('d-none'));
            }
        });

        function toggleTheme() {
            const html = document.documentElement;
            const newTheme = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-bs-theme', newTheme);
            newTheme === 'dark' ? html.classList.add('dark') : html.classList.remove('dark');
            localStorage.setItem('theme', newTheme);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
