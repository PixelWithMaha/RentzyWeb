@{
    ViewData["Title"] = "Password Reset Requested";
}

<style>
    /* Modern card styling for consistency */
    .card-modern {
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        border: none;
    }
</style>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 card-modern">
                <div class="card-body text-center py-4 px-4">

                    <i class="fas fa-check-circle mb-3" style="font-size: 3.5rem; color: #3B82F6 !important;"></i>

                    <h2 class="mt-3 fw-bold fs-4">Check Your Email</h2>

                    <p class="text-muted small mt-2 mb-2">
                        If your email exists in our system, you will receive a password reset link shortly.
                    </p>

                    <p class="text-muted small">
                        <small>Please check your spam folder if you don't see the email within a few minutes.</small>
                    </p>

                    <div class="mt-4">
                        <a asp-action="Login" class="btn btn-outline-primary w-75">
                            <i class="fas fa-arrow-left me-2"></i>Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>