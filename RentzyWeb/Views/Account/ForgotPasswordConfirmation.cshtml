@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <i class="fas fa-envelope-open-text text-primary mb-4" style="font-size: 5rem;"></i>
        <h2 class="mb-4">Check Your Email</h2>
        <p class="lead mb-4">
            We've sent a password reset link to your email address.
        </p>
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>For demo purposes:</strong> Click below to see the email preview
        </div>
        <a asp-action="EmailPreview" class="btn btn-primary btn-lg mt-3">
            <i class="fas fa-eye me-2"></i>View Email Preview
        </a>
    </div>
</div>