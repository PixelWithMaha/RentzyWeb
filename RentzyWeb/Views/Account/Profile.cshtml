@model Rentzy.BLL.DTOs.UserDTO
@{
    ViewData["Title"] = "My Profile";
}

<style>
    /* Custom dropdown that stays open on hover */
    .profile-dropdown {
        position: relative;
    }
    
    .profile-dropdown:hover .dropdown-menu {
        display: block;
    }
    
    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        z-index: 1000;
        margin-top: 0.5rem;
    }
    
    .profile-avatar {
        width: 120px;
        height: 120px;
        font-size: 48px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-lg border-0">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <h2 class="mb-0">
                        <i class="fas fa-user-circle text-primary me-2"></i>My Profile
                    </h2>
                    
                    <!-- Dropdown Menu on Hover -->
                    <div class="profile-dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button">
                            <i class="fas fa-cog me-1"></i> Account Settings
                        </button>
                        <ul class="dropdown-menu shadow">
                            <li>
                                <a class="dropdown-item" asp-action="EditProfile">
                                    <i class="fas fa-edit me-2 text-primary"></i>Edit Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-action="ChangePassword">
                                    <i class="fas fa-key me-2 text-warning"></i>Change Password
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-action="Logout" method="post" class="d-inline w-100">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-4">
                        <!-- Profile Picture Section -->
                        <div class="col-md-4">
                            <div class="text-center">
                                <div class="profile-avatar text-white rounded-circle d-inline-flex align-items-center justify-content-center shadow">
                                    @Model.FirstName.Substring(0, 1).ToUpper()@Model.LastName.Substring(0, 1).ToUpper()
                                </div>
                                <h4 class="mt-3 mb-1">@Model.FullName</h4>
                                <span class="badge bg-info text-white px-3 py-2">
                                    <i class="fas fa-user me-1"></i>@Model.UserType
                                </span>
                            </div>
                        </div>

                        <!-- Profile Details Section -->
                        <div class="col-md-8">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-info-circle me-2"></i>Account Information
                            </h5>
                            <dl class="row">
                                <dt class="col-sm-4">
                                    <i class="fas fa-user me-2 text-muted"></i>Full Name
                                </dt>
                                <dd class="col-sm-8">@Model.FullName</dd>

                                <dt class="col-sm-4">
                                    <i class="fas fa-envelope me-2 text-muted"></i>Email
                                </dt>
                                <dd class="col-sm-8">
                                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                                </dd>

                                <dt class="col-sm-4">
                                    <i class="fas fa-phone me-2 text-muted"></i>Phone
                                </dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">
                                    <i class="fas fa-user-tag me-2 text-muted"></i>Account Type
                                </dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">@Model.UserType</span>
                                </dd>

                                <dt class="col-sm-4">
                                    <i class="fas fa-calendar-alt me-2 text-muted"></i>Member Since
                                </dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Quick Actions Section -->
                    <div class="mt-4">
                        <h5 class="text-primary mb-3">
                            <i class="fas fa-bolt me-2"></i>Quick Actions
                        </h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <a asp-action="EditProfile" class="btn btn-outline-primary w-100 py-3">
                                    <i class="fas fa-edit d-block mb-2" style="font-size: 2rem;"></i>
                                    Edit Profile
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a asp-action="ChangePassword" class="btn btn-outline-warning w-100 py-3">
                                    <i class="fas fa-key d-block mb-2" style="font-size: 2rem;"></i>
                                    Change Password
                                </a>
                            </div>
                            <div class="col-md-4">
                                <form asp-action="Logout" method="post" class="w-100">
                                    <button type="submit" class="btn btn-outline-danger w-100 py-3">
                                        <i class="fas fa-sign-out-alt d-block mb-2" style="font-size: 2rem;"></i>
                                        Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Info Card -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-alt text-success me-3" style="font-size: 2rem;"></i>
                        <div>
                            <h6 class="mb-1">Your account is secure</h6>
                            <p class="text-muted mb-0 small">
                                Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div