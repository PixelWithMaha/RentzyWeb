@model Rentzy.Web.Models.UpdateProfileViewModel

@{
    ViewData["Title"] = "Update Personal Information";
}

<style>
    .card-modern {
        background: var(--theme-card-bg);
        border: 1px solid var(--theme-border) !important;
        border-radius: 1rem;
        box-shadow: var(--theme-shadow);
    }

    .card-header-modern {
        background-color: var(--theme-card-bg);
        border-bottom: 1px solid var(--theme-border);
        padding: 1.5rem;
        border-radius: 1rem 1rem 0 0;
    }

    .form-control {
        border-radius: 0.5rem;
        padding: 0.5rem 1rem; /* Thinner input boxes */
        border: 1px solid #ced4da;
        background-color: var(--theme-input-bg);
        color: var(--theme-text);
        border: 1px solid var(--theme-input-border) !important;
    }

    .btn-primary-custom {
        background-color: #3B82F6;
        border-color: #3B82F6;
        border-radius: 0.5rem;
        font-weight: 600;
    }

    .btn-secondary-custom {
        border-radius: 0.5rem;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-center py-3" style="background-color: var(--theme-bg); width: 100%;">
    <div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">

            <div class="card card-modern">
                <div class="card-header card-header-modern">
                    <h2 class="mb-0 text-primary">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="EditProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="form-group d-flex justify-content-end mt-4">
                            <a asp-action="Profile" class="btn btn-secondary-custom me-2">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary-custom">
                                <i class="fas fa-check me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}