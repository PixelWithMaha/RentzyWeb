@model Rentzy.Web.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <i class="fas fa-key text-primary mb-3" style="font-size: 3rem;"></i>
                        <h2 class="fw-bold">Change Password</h2>
                        <p class="text-muted">Update your account password</p>
                    </div>

                    <!-- Change Password Form -->
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger"></div>

                        <!-- Current Password -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-1"></i>Current Password
                            </label>
                            <input asp-for="CurrentPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Enter current password"
                                   autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">

                        <!-- New Password -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-1"></i>New Password
                            </label>
                            <input asp-for="NewPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <small class="text-muted">Must be at least 8 characters long</small>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-1"></i>Confirm New Password
                            </label>
                            <input asp-for="ConfirmPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check me-2"></i>Change Password
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Security Tip -->
            <div class="alert alert-info mt-4">
                <i class="fas fa-shield-alt me-2"></i>
                <strong>Security Tip:</strong> Use a strong password with letters, numbers, and special characters.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}