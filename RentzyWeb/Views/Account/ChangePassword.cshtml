@model Rentzy.Web.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<style>
    /* Custom styling for a modern card */
    .card-modern {
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        border: none;
    }

    /* Input styling for a thin and compact look */
    .form-control-compact {
        padding: 0.5rem 1rem; /* Slightly reduced padding */
        height: auto;
    }

    /* Style to reduce margin below labels */
    .form-label-compact {
        margin-bottom: 0.25rem !important;
        font-weight: 600; /* Keeping it bold */
    }
</style>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 card-modern">
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <i class="fas fa-key text-primary mb-2" style="font-size: 3rem; color: #3b82f6 !important;"></i>
                        <h2 class="fw-bold fs-4">Change Password</h2>
                        <p class="text-muted small">Update your account password</p>
                    </div>

                    <form asp-action="ChangePassword" method="post">

                        @if (!ViewContext.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="alert alert-danger py-2 small" role="alert"></div>
                        }

                        <div class="mb-2">
                            <label asp-for="CurrentPassword" class="form-label form-label-compact">
                                <i class="fas fa-lock me-1"></i>Current Password
                            </label>
                            <input asp-for="CurrentPassword"
                                   class="form-control form-control-compact"
                                   placeholder="Enter current password"
                                   autofocus />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-3">

                        <div class="mb-2">
                            <label asp-for="NewPassword" class="form-label form-label-compact">
                                <i class="fas fa-lock me-1"></i>New Password
                            </label>
                            <input asp-for="NewPassword"
                                   class="form-control form-control-compact"
                                   placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Must be at least 8 characters long</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label form-label-compact">
                                <i class="fas fa-lock me-1"></i>Confirm New Password
                            </label>
                            <input asp-for="ConfirmPassword"
                                   class="form-control form-control-compact"
                                   placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check me-2"></i>Change Password
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3 py-2 small">
                <i class="fas fa-shield-alt me-2"></i>
                <strong>Security Tip:</strong> Use a strong password with letters, numbers, and special characters.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}