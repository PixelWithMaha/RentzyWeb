@model Rentzy.Web.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    // Set up modern styles for the card, matching Login/Change Password
}

<style>
    .card-modern {
        background: var(--theme-card-bg);
        border: 1px solid var(--theme-border) !important;
        border-radius: 1rem;
        box-shadow: var(--theme-shadow);
    }

    .form-control-compact {
        padding: 0.6rem 1rem;
        height: auto;
    }
</style>

<div class="d-flex justify-content-center py-3" style="background-color: var(--theme-bg); width: 100%;">
    <div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 card-modern">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <i class="fas fa-key mb-3" style="font-size: 3rem; color: #3B82F6 !important;"></i>
                        <h2 class="fw-bold fs-4">Forgot Password</h2>
                        <p class="text-muted small">Enter your email address to reset your password.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">

                        @if (!ViewContext.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                        }

                        <div class="form-group mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="fas fa-envelope me-1"></i>Email Address
                            </label>
                            <input asp-for="Email"
                                   class="form-control form-control-compact"
                                   type="email"
                                   placeholder="Enter your email"
                                   autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Send Reset Link
                            </button>
                        </div>

                        <div class="text-center">
                            <hr class="my-3" />
                            <p class="mb-0">
                                Remember your password?
                                <a asp-action="Login" class="text-decoration-none fw-semibold">Login here</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}